# LLM Provider Keys
# Copy this file to .env.llm and fill in your keys.
# These are loaded by the dev server and Docker container.
#
# NOTE: In production, API keys are passed per-request from the browser
# via the X-Provider-Keys header (stored in browser localStorage).
# Server-side env vars are only needed for:
#   1. Local development auto-injection
#   2. Langfuse tracing
#   3. Server-initiated LLM calls (if any)

# ── DeepSeek ─────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── DashScope (Alibaba Cloud / Qwen) ────────────────────────────
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── OpenAI ───────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic ────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OpenRouter (used by embedding bench Phase 0) ─────────────────
# OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Groq ─────────────────────────────────────────────────────────
# GROQ_API_KEY=gsk_xxx
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Cerebras ─────────────────────────────────────────────────────
# CEREBRAS_API_KEY=csk-xxx
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ── Packey / gateway-compatible providers ────────────────────────
# PACKEY_API_KEY=sk-xxx
# PACKEY_BASE_URL=https://api.packey.ai/v1

# ── Local OpenAI-compatible endpoint ──────────────────────────────
# LOCAL_API_KEY=local-placeholder
# LOCAL_BASE_URL=http://localhost:1234/v1

# ── Ollama (local, used as default embedding backend) ────────────
# Run: ollama pull nomic-embed-text-v2-moe && ollama serve
# OLLAMA_BASE_URL=http://localhost:11434
