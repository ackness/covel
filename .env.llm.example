# LLM Provider Keys
# Copy this file to .env.llm and fill in your keys.
# These are loaded by the dev server and Docker container.
#
# NOTE: In production, API keys are passed per-request from the browser
# via the X-Provider-Keys header (stored in browser localStorage).
# Server-side env vars are only needed for:
#   1. Local development auto-injection
#   2. Langfuse tracing
#   3. Server-initiated LLM calls (if any)

# ── DeepSeek ─────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── DashScope (Alibaba Cloud / Qwen) ────────────────────────────
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── OpenAI ───────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic ────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
