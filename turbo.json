{
  "$schema": "https://v2-9-4.turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "dev:pg": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@covel/web#build": {
      "dependsOn": ["^build", "generate:routes"],
      "outputs": ["../../dist/web/**"]
    },
    "@covel/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "staging/**"]
    },
    "generate:routes": {
      "cache": true,
      "inputs": ["src/routes/**", "vite.config.ts", "package.json"],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/plugins/*/*.md",
        "$TURBO_ROOT$/plugins/*/*.js",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/{hooks,lib,runtimes,schemas,server,tests,tools,ui}/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "@covel/web#lint": {
      "dependsOn": ["^build", "generate:routes"]
    },
    "clean": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:studio": {
      "persistent": true,
      "cache": false
    }
  }
}
