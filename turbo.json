{
  "$schema": "https://v2-9-4.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@covel/web#build": {
      "dependsOn": ["^build", "generate:routes"],
      "outputs": ["../../dist/web/**"],
      "env": ["VITE_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local",
        "$TURBO_ROOT$/.env.production",
        "$TURBO_ROOT$/.env.production.local"
      ]
    },
    "@covel/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "staging/**"]
    },
    "generate:routes": {
      "cache": true,
      "inputs": ["src/routes/**", "vite.config.ts", "package.json"],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.base.ts"
      ]
    },
    "@covel/plugin-loader#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.base.ts",
        "$TURBO_ROOT$/plugins/*/*.md",
        "$TURBO_ROOT$/plugins/*/*.js",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/{hooks,lib,runtimes,schemas,server,tests,tools,ui}/**"
      ]
    },
    "@covel/runtime#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.base.ts",
        "$TURBO_ROOT$/plugins/*/*.md",
        "$TURBO_ROOT$/plugins/*/*.js",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/{hooks,lib,runtimes,schemas,server,tests,tools,ui}/**"
      ]
    },
    "@covel/server#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.base.ts",
        "$TURBO_ROOT$/scripts/e2e-plugin-verify.ts",
        "$TURBO_ROOT$/plugins/*/*.md",
        "$TURBO_ROOT$/plugins/*/*.js",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/{hooks,lib,runtimes,schemas,server,tests,tools,ui}/**",
        "$TURBO_ROOT$/scripts/lib/**",
        "$TURBO_ROOT$/scripts/dev-pg-preflight.mjs"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "@covel/web#lint": {
      "dependsOn": ["^build", "generate:routes"]
    },
    "clean": {
      "cache": false
    }
  }
}
