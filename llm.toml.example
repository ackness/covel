# ── Covel LLM Configuration ──────────────────────────────────────
#
# Copy this file to `llm.toml` and edit to match your provider setup.
# API keys go in `.env.llm` (not here).
#
# Each [covel.<name>] defines a model slot.
# Slot names are user-defined (e.g., "story", "utility", "image").
# Each slot has a `tag` (auto-inferred from output modalities if omitted):
#   - "text"  — text generation models (default)
#   - "image" — image generation models
#
# Tags determine compatibility: a runtime requiring "text" can only
# use slots tagged "text". Cross-tag fallback is forbidden.
#
# Players assign slots to runtimes before starting a game.
#
# Fields:
#   provider   — provider identifier, maps to {PROVIDER}_API_KEY in .env.llm
#   model      — opaque model ID passed to the provider API unchanged
#   baseUrl    — API endpoint URL
#   protocol   — "openai-chat-v1" | "openai-responses-v1" | "anthropic-messages-v1"
#   fallback   — (optional) slot name to fall back to on failure (same tag only)
#   tag        — (optional) capability tag, auto-inferred from output modalities
#
# One provider can expose multiple IDs, including namespaced forms such as
# "openai/gpt-5.6-sol" or "deepseek/deepseek-v4-flash". Keep the provider
# identifier separate; Covel never removes the namespace from outbound calls.
#
# You can also use environment variables in values, e.g.:
#   baseUrl = "${DEEPSEEK_BASE_URL}"

# ── Text Slots ──────────────────────────────────────────────────

[covel.story]
provider = "deepseek"
model    = "deepseek-v4-flash"
baseUrl  = "https://api.deepseek.com"
protocol = "openai-chat-v1"
# 可选：DeepSeek V4 支持 "high" / "max"；留空使用服务商默认值。
# reasoning_effort = "high"
# thinking = { type = "enabled" }

[covel.utility]
provider = "dashscope"
model    = "qwen3.6-flash"
baseUrl  = "https://dashscope.aliyuncs.com/compatible-mode/v1"
protocol = "openai-chat-v1"
fallback = "story"

# ── Image Slot (optional) ───────────────────────────────────────
#
# Image generation requires `imageApi` to specify which API format the model uses.
# Two formats are supported:
#   "dashscope-wan" — DashScope WAN async task API (wan2.x models, Chinese prompts)
#   "openai-chat"   — Chat completions returning image (gpt-4o-image etc., English prompts)
# Default when omitted: "openai-chat"
#
# Option A: DashScope WAN (async task API, Chinese prompts recommended)
# [covel.image]
# provider  = "dashscope"
# model     = "wan2.7-image-pro"
# baseUrl   = "https://dashscope.aliyuncs.com"
# protocol  = "openai-chat-v1"
# tag       = "image"
# output    = ["image"]
# imageApi  = "dashscope-wan"          # ← required: selects WAN async task API
#
# Option B: OpenAI chat completions image format (English prompts recommended)
# [covel.image]
# provider  = "openai"
# model     = "gpt-image-1.5"
# baseUrl   = "https://api.openai.com"
# protocol  = "openai-chat-v1"
# tag       = "image"
# output    = ["image"]
# imageApi  = "openai-chat"            # ← optional: this is the default

# ── Embedding Slots (RAG / Graph-RAG) ────────────────────────────
#
# RAG plugins (e.g. core-npc-graph) need an embedding model. Without an
# embed slot here, vector storage stays empty and those plugins silently
# fall back to structured retrieval (BFS on the knowledge graph).
#
# How it works:
#   - Slot is identified by `output = ["embedding"]`.
#   - First such slot becomes the `embed-default` target for gateway.embed().
#   - On a session's first turn the server probes the model once
#     (gateway.embed("…")) to detect its output dimension, registers a
#     `vector_models` entry, and locks the session to that model. Per-model
#     physical vector tables (`vec_mem_m{id}`) are created on demand —
#     you do not need to specify dimensions in this file.
#   - Switching the slot to a different model creates a new vector table
#     for new sessions; existing sessions continue using their locked
#     model. Switching back continues writing into the original table.
#   - `embeddingFormat` selects the request body shape:
#       "openai"              — standard {input: string[]} (default)
#       "nemotron-multimodal" — NVIDIA Nemotron {input: [{content: [...]}]}
#
# ── RAG Quick Start ──────────────────────────────────────────────
# Pick ONE of the examples below and uncomment it. After that:
#   - SQLite backend: sqlite-vec is bundled, RAG works out-of-the-box.
#   - PG backend: docker-compose uses pgvector image — also out-of-the-box.
#
# Example A: local Ollama (recommended for offline / private dev)
# Prereqs: `ollama pull nomic-embed-text-v2-moe && ollama serve`
# Output dimension: 768 (probed automatically — no config needed)
#
# [covel.embed-default]
# provider = "ollama"
# model    = "nomic-embed-text-v2-moe"
# baseUrl  = "http://localhost:11434/v1"
# protocol = "openai-chat-v1"
# output   = ["embedding"]
# # embeddingFormat = "openai"   # ← default, can omit
#
# Example B: OpenAI text-embedding-3-small (paid, no local setup)
# Output dimension: 1536
#
# [covel.embed-default]
# provider = "openai"
# model    = "text-embedding-3-small"
# baseUrl  = "https://api.openai.com/v1"
# protocol = "openai-chat-v1"
# output   = ["embedding"]
#
# Example C: OpenRouter NVIDIA Nemotron multimodal (vision embedding, 2048d)
# Works for text-only too; accepts image_url content parts when Phase 2
# multimodal values land.
#
# [covel.embed-multimodal]
# provider = "openrouter"
# model    = "nvidia/llama-nemotron-embed-vl-1b-v2:free"
# baseUrl  = "https://openrouter.ai/api/v1"
# protocol = "openai-chat-v1"
# output   = ["embedding"]
# input    = ["text", "image"]
# embeddingFormat = "nemotron-multimodal"

# ── Capability Override (optional) ───────────────────────────────
#
# Model capabilities (input/output modalities, features, token limits,
# pricing) are auto-inferred from a built-in database of ~60 common models.
# Override any field if the auto-detection is wrong or for custom/private models.
#
# NOTE: "image" in input = vision (can see images), NOT image generation.
#       "image" in output = image generation. Same logic for audio/video.
#
# [covel.multimodal]
# provider = "dashscope"
# model    = "qwen-omni-turbo"
# baseUrl  = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# protocol = "openai-chat-v1"
# input    = ["text", "image", "audio", "video"]
# output   = ["text", "audio"]
# features = ["function_calling", "streaming", "vision"]
# contextWindow   = 131072
# maxOutputTokens = 8192
#
# [covel.multimodal.pricing]
# inputPerMToken  = 0.6
# outputPerMToken = 1.5

# ── Examples for other providers ─────────────────────────────────
#
# [covel.story]
# provider = "openai"
# model    = "gpt-5.4"
# baseUrl  = "https://api.openai.com/v1"
# protocol = "openai-chat-v1"
#
# [covel.story]
# provider = "anthropic"
# model    = "claude-sonnet-4-6"
# baseUrl  = "https://api.anthropic.com"
# protocol = "anthropic-messages-v1"
