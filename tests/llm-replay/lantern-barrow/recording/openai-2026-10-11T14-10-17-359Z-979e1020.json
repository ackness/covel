            "name": "submit-world-facts",
            "arguments": "{\"summary\": \"玩家进入酒馆，梅瑞尔・沃斯报出村长悬赏三十枚银币寻找失踪三天的人和熄灭的灯，并声明住宿一晚两枚银币、不赊账；布兰诺克・黑尔提及二十年前同样的悬赏与六个去者。雷恩修女自称来自黎明灯修会，为检查古灯而来，并希望先与下墓的人谈谈铭文上的异常。还有风声传来像是从远处来的细响。\", \"entities\": [{\"id\": \"village-chief\", \"type\": \"character\", \"name\": \"村长\", \"description\": \"出三十枚银币悬赏寻找失踪者与查明灯灭的人，家中挂着领主徽记。\"}, {\"id\": \"morning-light-order\", \"type\": \"faction\", \"name\": \"黎明灯修会\", \"description\": \"雷恩修女所属的修会，负责检查古灯。\"}, {\"id\": \"old-sword\", \"type\": \"item\", \"name\": \"旧剑\", \"description\": \"布兰诺克・黑尔手中的旧剑，剑身很旧，护手却擦得发亮。\", \"attributes\": {\"holder\": \"布兰诺克-黑尔\", \"condition\": \"剑身陈旧，护手保养良好\"}}, {\"id\": \"inscription-book\", \"type\": \"item\", \"name\": \"手抄铭文册\", \"description\": \"摊在靠窗桌上的手抄铭文册，纸页边缘被翻得起了毛。\", \"attributes\": {\"holder\": \"雷恩修女\"}}, {\"id\": \"copper-lamp\", \"type\": \"item\", \"name\": \"铜灯\", \"description\": \"雷恩修女颈间挂着的小铜灯。\"}, {\"id\": \"ancient-lamp\", \"type\": \"concept\", \"name\": \"古灯\", \"description\": \"雷恩修女前来检查的灯，已晚了三天。\"}], \"relations\": [], \"events\": [{\"id\": \"player-enters-tavern\", \"type\": \"movement\", \"participantIds\": [\"e2e测试角色\"], \"description\": \"玩家推门进入酒馆。\", \"attributes\": {\"destination\": \"酒馆\"}}, {\"id\": \"merrill-offers-bounty\", \"type\": \"interaction\", \"participantIds\": [\"梅瑞尔-沃斯\", \"e2e测试角色\"], \"description\": \"梅瑞尔・沃斯向玩家报出村长悬赏三十枚银币，并说明食宿两枚银币一晚、不赊账。\", \"attributes\": {\"giver\": \"village-chief\", \"reward\": \"三十枚银币\"}}, {\"id\": \"blackwell-recounts-precedent\", \"type\": \"interaction\", \"participantIds\": [\"布兰诺克-黑尔\"], \"description\": \"布兰诺克・黑尔提到二十年前有人出过五十枚银币悬赏，去的人有六个。\", \"attributes\": {\"yearsAgo\": 20, \"previousReward\": \"五十枚银币\", \"previousPartySize\": 6}}, {\"id\": \"wren-introduces-herself\", \"type\": \"interaction\", \"participantIds\": [\"雷恩修女\", \"e2e测试角色\"], \"description\": \"雷恩修女向玩家自我介绍来自黎明灯修会，为检查古灯而来，并希望先与下墓的人谈谈。\", \"attributes\": {\"affiliation\": \"morning-light-order\", \"delayDays\": 3}}], \"statements\": [{\"id\": \"bounty-details\", \"type\": \"quest\", \"content\": \"村长悬赏三十枚银币寻找失踪三天的人并查明灯灭三晚的原因；村长家挂着领主徽记，目前比谁都着急。\", \"subjectIds\": [\"village-chief\"], \"attributes\": {\"giver\": \"village-chief\", \"reward\": \"三十枚银币\", \"missingDays\": 3, \"lampOutNights\": 3}}, {\"id\": \"tavern-lodging-price\", \"type\": \"rule\", \"content\": \"酒馆一晚食宿两枚银币，梅瑞尔・沃斯不赊账。\", \"subjectIds\": [\"梅瑞尔-沃斯\"], \"attributes\": {\"price\": \"两枚银币\", \"credit\": false}}, {\"id\": \"inscription-anomaly\", \"type\": \"discovery\", \"content\": \"雷恩修女所读铭文册上的一句刻纹不该出现在灯座的铭文里，她读过很多遍仍觉异常。\", \"subjectIds\": [\"雷恩修女\"], \"attributes\": {\"object\": \"灯座铭文\"}}, {\"id\": \"reed-snapping-sound\", \"type\": \"lore\", \"content\": \"窗外雨中的风里夹着芦苇折断似的轻响，很细，像从很远的地方传过来。\", \"attributes\": {\"nature\": \"不明来源的细响\"}}]}",
