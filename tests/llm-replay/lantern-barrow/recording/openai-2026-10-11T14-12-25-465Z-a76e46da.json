            "name": "submit-world-facts",
            "arguments": "{\"summary\": \"三人在酒馆吧台前商议如何前往古冢：布兰诺克・黑尔给出二十年前下墓的经历与\\\"灭灯中切勿点火\\\"的警告，雷恩修女说明她要到灯座底下读取铭文册上那句多出的收尾，并提到自己晚到三天、途中被王都学院袍服的人拦过一次。梅瑞尔・沃斯点出三人像是已经接下了这趟差事，等着玩家角色先开口。\", \"entities\": [{\"id\": \"王都学院\", \"type\": \"faction\", \"name\": \"王都学院\", \"description\": \"王都的学院，其袍服之人曾拦截雷恩修女。\", \"attributes\": {}}], \"relations\": [{\"id\": \"academy-blocked-reyne\", \"type\": \"OPPOSES\", \"from\": \"王都学院\", \"to\": \"雷恩修女\", \"description\": \"王都学院的人曾在雷恩修女前往古冢途中拦截她一次。\", \"attributes\": {}}], \"events\": [{\"id\": \"branoc-warns-lights\", \"type\": \"interaction\", \"participantIds\": [\"布兰诺克-黑尔\", \"e2e测试角色\", \"雷恩修女\"], \"description\": \"布兰诺克・黑尔在酒馆吧台前向同伴讲述二十年前下墓的经历，警告在灭灯的廊子里不要点火。\", \"attributes\": {\"topic\": \"古冢内的灭灯与点火禁忌\", \"detail\": \"六人进去只有他一人出来\"}}, {\"id\": \"reyne-explains-goal\", \"type\": \"interaction\", \"participantIds\": [\"雷恩修女\", \"e2e测试角色\"], \"description\": \"雷恩修女说明她要去灯座底下，因为灯心已不在灯里，铭文册上那句多余的收尾只有站在灯座上才读得出含义。\", \"attributes\": {\"topic\": \"灯座与铭文册收尾句\"}}, {\"id\": \"reyne-delayed\", \"type\": \"interaction\", \"participantIds\": [\"雷恩修女\", \"王都学院\"], \"description\": \"雷恩修女称修会路程单写四天，她走了七天，中途被一名穿王都学院袍服的人拦了一次。\", \"attributes\": {\"actor\": \"雷恩修女\", \"target\": \"王都学院\", \"detail\": \"晚到三天\"}}, {\"id\": \"merril-presses\", \"type\": \"interaction\", \"participantIds\": [\"梅瑞尔-沃斯\", \"e2e测试角色\"], \"description\": \"梅瑞尔・沃斯指出三人商量的样子像已经接下了差事，等待玩家角色先开口。\", \"attributes\": {\"topic\": \"是否接下这趟差事\"}}], \"statements\": [{\"id\": \"lamp-warning\", \"type\": \"lore\", \"content\": \"古冢内的廊子里全是灭掉的灯；在其中点亮一盏灯，灯就会朝点亮者转过来一分。\", \"subjectIds\": [\"布兰诺克-黑尔\"], \"attributes\": {\"source\": \"布兰诺克・黑尔的亲身经历\"}}, {\"id\": \"reyne-inscription\", \"type\": \"discovery\", \"content\": \"灯心已不在灯里；铭文册上那句多余的收尾，只有站在灯座上才读得出含义。\", \"subjectIds\": [\"雷恩修女\"], \"attributes\": {}}]}",
