{
  "id": "fake-oauth-settings",
  "label": "Fake Subscription Accounts",
  "sectionGroup": "llm",
  "dataSource": {
    "source": "instance.data",
    "namespace": "accounts"
  },
  "view": {
    "component": "Stack",
    "props": { "gap": "sm" },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": "Manage authenticated accounts for Fake Subscription."
        }
      },
      {
        "component": "Button",
        "props": { "label": "Sign in (OAuth)" },
        "on": {
          "press": {
            "action": "startFlow",
            "params": {
              "pluginId": "fake-oauth-provider-source",
              "flowId": "oauth-sign-in"
            }
          }
        }
      },
      {
        "component": "Button",
        "props": { "label": "Import Token" },
        "on": {
          "press": {
            "action": "startFlow",
            "params": {
              "pluginId": "fake-oauth-provider-source",
              "flowId": "paste-import"
            }
          }
        }
      }
    ]
  }
}
