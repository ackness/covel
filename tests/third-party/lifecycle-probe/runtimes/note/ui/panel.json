{
  "id": "lifecycle-probe-panel",
  "label": "Lifecycle Probe",
  "icon": "flask-conical",
  "alwaysRender": true,
  "dataSource": {
    "namespace": "notes"
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "sm"
    },
    "children": [
      {
        "component": "Button",
        "props": {
          "label": "Show status"
        },
        "on": {
          "click": {
            "action": "invokeCommand",
            "params": {
              "command": "probe",
              "args": {}
            }
          }
        }
      },
      {
        "component": "Button",
        "props": {
          "label": "Write note"
        },
        "on": {
          "click": {
            "action": "invokeRuntime",
            "params": {
              "runtimeId": "lifecycle-probe/note"
            }
          }
        }
      },
      {
        "component": "Button",
        "props": {
          "label": "Run background job"
        },
        "on": {
          "click": {
            "action": "invokeRuntime",
            "params": {
              "runtimeId": "lifecycle-probe/background"
            }
          }
        }
      },
      {
        "component": "Button",
        "props": {
          "label": "Run agent"
        },
        "on": {
          "click": {
            "action": "invokeRuntime",
            "params": {
              "runtimeId": "lifecycle-probe/agent"
            }
          }
        }
      },
      {
        "component": "Stack",
        "repeat": {
          "statePath": "/entries",
          "key": "key"
        },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": {
                "$item": "value/text"
              }
            }
          }
        ]
      }
    ]
  }
}
