{
  "schemaVersion": "1.0",
  "id": "core-npc-init",
  "displayName": {
    "zh-CN": "NPC 初始化",
    "en-US": "NPC Initializer"
  },
  "version": "0.1.0",
  "author": "covel",
  "description": {
    "zh-CN": "分析世界观文档，自动创建角色字段 schema 并初始化 NPC 角色卡。",
    "en-US": "Analyze world lore to auto-generate character field schema and initialize NPC character cards."
  },
  "defaultLocale": "zh-CN",
  "supportedLocales": [
    "zh-CN",
    "en-US"
  ],
  "loadingOrder": 25,
  "runtimes": [
    {
      "id": "npc-init",
      "pluginId": "core-npc-init",
      "kind": "plugin",
      "priority": 420,
      "trigger": {
        "mode": "event",
        "onEvents": [
          "session_start"
        ]
      },
      "providerBinding": "default",
      "tools": [
        "core-npc-init:define-character-schema",
        "core-npc-init:create-npc",
        "core-npc-init:finalize-init"
      ],
      "hooks": [],
      "budget": {
        "maxSteps": 25,
        "timeoutMs": 120000,
        "maxToolCalls": 40
      }
    }
  ],
  "blockSchemas": [
    {
      "type": "npc_init_summary",
      "interactive": false,
      "meta": {
        "displayName": {
          "zh-CN": "NPC 初始化摘要",
          "en-US": "NPC Init Summary"
        },
        "description": "Shows NPC initialization results"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "npcCount": {
            "type": "number"
          },
          "summary": {
            "type": "string"
          },
          "completedAt": {
            "type": "string"
          }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "define-character-schema",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "description": "Define the character field schema for this world. Call this FIRST before creating any NPCs.",
        "properties": {
          "fields": {
            "type": "array",
            "description": "Ordered list of field definitions for the character table.",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Machine key, e.g. 'hp', 'mana', 'faction'"
                },
                "label": {
                  "type": "string",
                  "description": "Human-readable label"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "number",
                    "string",
                    "boolean",
                    "enum",
                    "text"
                  ],
                  "description": "Field value type"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Allowed values for enum type"
                },
                "defaultValue": {
                  "description": "Default value for new characters"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "stats",
                    "bio",
                    "equipment",
                    "social",
                    "custom"
                  ],
                  "description": "Grouping category"
                },
                "visible": {
                  "type": "boolean",
                  "description": "Show in compact view (default true)"
                },
                "min": {
                  "type": "number",
                  "description": "Minimum value for number type"
                },
                "max": {
                  "type": "number",
                  "description": "Maximum value for number type"
                }
              },
              "required": [
                "key",
                "label",
                "type"
              ]
            }
          }
        },
        "required": [
          "fields"
        ]
      }
    },
    {
      "id": "create-npc",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "description": "Create an NPC character card with dynamic fields. Call define-character-schema first.",
        "properties": {
          "name": {
            "type": "string",
            "description": "NPC name"
          },
          "description": {
            "type": "string",
            "description": "Brief description of the NPC"
          },
          "type": {
            "type": "string",
            "enum": [
              "npc",
              "companion"
            ],
            "description": "'companion' if the NPC can join the player's party"
          },
          "fields": {
            "type": "object",
            "description": "Dynamic field values matching the schema keys",
            "additionalProperties": true
          }
        },
        "required": [
          "name",
          "description",
          "type",
          "fields"
        ]
      }
    },
    {
      "id": "finalize-init",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "description": "Signal that NPC initialization is complete. Call this as the LAST step.",
        "properties": {
          "summary": {
            "type": "string",
            "description": "Brief summary of what was initialized"
          },
          "npcCount": {
            "type": "number",
            "description": "Number of NPCs created"
          }
        },
        "required": [
          "summary",
          "npcCount"
        ]
      }
    }
  ]
}