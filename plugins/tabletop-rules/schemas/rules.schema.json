{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["budget", "attributes"],
  "properties": {
    "id": { "const": "creation" },
    "budget": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "base", "max"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "label": { "type": "string" },
          "base": { "type": "integer" },
          "max": { "type": "integer" }
        }
      }
    }
  }
}
