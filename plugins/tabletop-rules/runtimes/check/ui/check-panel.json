{
  "id": "tabletop-rules",
  "label": "Attribute checks",
  "icon": "dices",
  "alwaysRender": true,
  "dataSource": { "namespace": "checks" },
  "view": {
    "component": "Button",
    "props": {
      "label": "Request an attribute check"
    },
    "on": {
      "click": {
        "action": "invokeRuntime",
        "params": {
          "runtimeId": "tabletop-rules/check",
          "payload": { "openForm": true }
        }
      }
    }
  }
}
