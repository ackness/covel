{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://inventory/items",
  "type": "object",
  "required": ["id", "name", "quantity"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "quantity": { "type": "integer", "minimum": 0 },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "equipped": { "type": "boolean" },
    "effects": {
      "type": "object",
      "description": "What carrying the item changes in the rules.",
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "object",
          "description": "A modifier that checks of one attribute get while the item is carried.",
          "additionalProperties": false,
          "required": ["attribute", "modifier"],
          "properties": {
            "attribute": {
              "type": "string",
              "minLength": 1,
              "description": "The id of a check attribute of the player character."
            },
            "modifier": {
              "type": "integer",
              "minimum": -5,
              "maximum": 5,
              "not": { "const": 0 }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "if": {
    "properties": { "removed": { "const": true } },
    "required": ["removed"]
  },
  "then": {
    "properties": { "quantity": { "const": 0 } }
  }
}
