{
  "schemaVersion": "1.0",
  "id": "core-notification",
  "displayName": {
    "zh-CN": "通知系统",
    "en-US": "Notification"
  },
  "version": "0.1.0",
  "author": "covel",
  "description": {
    "zh-CN": "在游戏过程中提供结构化的警报和反馈通知，包括信息、警告、成功和错误类型。",
    "en-US": "Provides structured alerts and feedback during gameplay, including info, warning, success, and error types."
  },
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en-US"],
  "loadingOrder": 90,
  "runtimes": [],
  "tools": [
    {
      "id": "emit-notification",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": ["info", "warning", "success", "error"],
            "description": "Severity level of the notification"
          },
          "title": {
            "type": "string",
            "description": "Short title of the notification"
          },
          "content": {
            "type": "string",
            "description": "Optional detailed content or description"
          },
          "source": {
            "type": "string",
            "description": "Optional identifier of the plugin or system that emitted this notification"
          }
        },
        "required": ["level", "title"]
      }
    }
  ],
  "blockSchemas": [
    {
      "type": "notification",
      "interactive": false,
      "meta": {
        "displayName": { "zh-CN": "通知", "en-US": "Notification" },
        "description": "Structured alert or feedback notification"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": ["info", "warning", "success", "error"]
          },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  ]
}
