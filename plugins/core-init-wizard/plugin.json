{
  "schemaVersion": "1.0",
  "id": "core-init-wizard",
  "displayName": {
    "zh-CN": "角色初始化向导",
    "en-US": "Character Init Wizard"
  },
  "version": "0.2.0",
  "author": "covel",
  "description": {
    "zh-CN": "在 session_start 时弹出角色创建表单，引导用户创建角色。",
    "en-US": "On session_start, emit a character creation form to guide the player through character setup."
  },
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en-US"],
  "loadingOrder": 30,
  "blockSchemas": [
    {
      "type": "character_creation",
      "interactive": true,
      "meta": {
        "displayName": { "zh-CN": "角色创建", "en-US": "Character Creation" },
        "description": "Dynamic character creation form"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string", "enum": ["text", "select", "textarea", "number"] },
                "placeholder": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" } },
                "required": { "type": "boolean" }
              },
              "required": ["key", "label", "type"]
            }
          }
        }
      },
      "submitSchema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "runtimes": [
    {
      "id": "init-wizard",
      "pluginId": "core-init-wizard",
      "kind": "plugin",
      "priority": 450,
      "trigger": {
        "mode": "event",
        "onEvents": ["session_start"]
      },
      "providerBinding": "default",
      "tools": ["emit-character-form"],
      "hooks": []
    }
  ],
  "tools": [
    {
      "id": "emit-character-form",
      "kind": "render",
      "schema": {
        "type": "object",
        "description": "Display the character creation form to the player. Call this after writing a short narrative transition.",
        "properties": {}
      }
    }
  ]
}
