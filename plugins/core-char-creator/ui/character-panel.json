{
  "id": "character",
  "group": "character",
  "groupLabel": { "zh": "角色", "en": "Characters" },
  "groupOrder": 100,
  "label": { "zh": "角色", "en": "Characters" },
  "icon": "users",
  "dataSource": { "namespace": "characters" },
  "emptyState": { "message": { "zh": "尚未创建角色，完成角色创建流程后将在此显示……", "en": "No characters created yet, complete the character creation flow to see them here…" } },
  "view": {
    "component": "Stack",
    "props": { "gap": "sm" },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": { "zh": "所有角色", "en": "All Characters" },
          "weight": "bold",
          "size": "sm"
        }
      },
      {
        "component": "Separator"
      },
      {
        "component": "CardList",
        "repeat": { "statePath": "/entries", "key": "key" },
        "children": [
          {
            "component": "Card",
            "children": [
              {
                "component": "Row",
                "props": { "gap": "sm" },
                "children": [
                  {
                    "component": "Icon",
                    "props": { "name": "user", "size": "sm" }
                  },
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/name" },
                      "weight": "bold",
                      "size": "sm"
                    }
                  },
                  {
                    "component": "Badge",
                    "props": {
                      "label": { "$item": "value/type" },
                      "color": "blue"
                    }
                  }
                ]
              },
              {
                "component": "Text",
                "props": {
                  "content": { "$item": "value/description" },
                  "variant": "muted",
                  "size": "xs"
                }
              },
              {
                "component": "CharacterFieldsView",
                "props": {
                  "value": { "$item": "value/fields" }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
