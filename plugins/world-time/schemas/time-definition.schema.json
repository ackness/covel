{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "const": "world"
    },
    "definition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "calendar"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "calendar": {
              "type": "object",
              "properties": {
                "era": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "months": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      }
                    },
                    "required": ["name", "days"],
                    "additionalProperties": false
                  }
                },
                "hoursPerDay": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "minutesPerHour": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "weekdays": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                },
                "periods": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "startHour": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["name", "startHour"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["era", "months", "hoursPerDay", "minutesPerHour"],
              "additionalProperties": false
            },
            "initial": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "weekday": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["year", "month", "day", "hour", "minute"],
              "additionalProperties": false
            },
            "evolution": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["forward", "backward", "bidirectional", "random"]
                },
                "defaultStep": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "maxStep": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "randomRange": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "max": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "required": ["min", "max"],
                  "additionalProperties": false
                },
                "prompt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "required": ["mode", "defaultStep", "maxStep"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "name", "calendar", "initial", "evolution"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "phases"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "phases": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "cycleLabel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "initial": {
              "type": "object",
              "properties": {
                "cycle": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "phase": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["cycle", "phase"],
              "additionalProperties": false
            },
            "evolution": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["forward", "backward", "bidirectional", "random"]
                },
                "defaultStep": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "maxStep": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "randomRange": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "max": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "required": ["min", "max"],
                  "additionalProperties": false
                },
                "prompt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "required": ["mode", "defaultStep", "maxStep"],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "name",
            "phases",
            "cycleLabel",
            "initial",
            "evolution"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["id", "definition"],
  "additionalProperties": false
}
