{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contract:world-time-context@1",
  "title": "Covel current world time output v1",
  "type": "object",
  "required": ["schemaVersion", "definition", "tick", "display"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "definition": { "type": "object" },
    "tick": { "type": "integer" },
    "display": { "type": "string" },
    "units": { "type": "array", "items": { "type": "string" } },
    "locale": { "type": "string" }
  },
  "additionalProperties": true
}
