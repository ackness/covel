{
  "id": "world-time",
  "label": "World Time",
  "icon": "calendar-days",
  "groupOrder": 100,
  "dataSource": {
    "namespace": "clock"
  },
  "emptyState": {
    "message": "Time appears when the story starts."
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "sm"
    },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": {
            "$state": "/current/display"
          },
          "size": "lg"
        }
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "$state": "/current/reason"
          },
          "variant": "muted",
          "size": "sm"
        }
      }
    ]
  }
}
