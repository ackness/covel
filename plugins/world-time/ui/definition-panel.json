{
  "id": "time-definition",
  "label": "Time rules",
  "icon": "calendar-days",
  "groupOrder": 101,
  "dataSource": {
    "namespace": "definitions"
  },
  "emptyState": {
    "message": "Uses the default world calendar: 12 months of 30 days, 24-hour days; starts at year 1, month 1, day 1, 08:00."
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "sm"
    },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": {
            "$state": "/world/definition/name"
          },
          "size": "lg"
        }
      },
      {
        "component": "Text",
        "visible": {
          "$state": "/world/definition/evolution/prompt"
        },
        "props": {
          "content": {
            "$state": "/world/definition/evolution/prompt"
          },
          "size": "sm"
        }
      },
      {
        "component": "Grid",
        "visible": {
          "$state": "/world/definition/kind",
          "eq": "phases"
        },
        "props": {
          "cols": 2
        },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": "Phases",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Grid",
            "repeat": {
              "statePath": "/world/definition/phases"
            },
            "props": {
              "cols": 2
            },
            "children": [
              {
                "component": "Badge",
                "props": { "label": { "$item": "" } }
              }
            ]
          },
          {
            "component": "Text",
            "props": {
              "content": "Cycle",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$state": "/world/definition/cycleLabel"
              },
              "size": "sm"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": "Starts at",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Row",
            "props": {
              "gap": "xs"
            },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": { "$state": "/world/definition/cycleLabel" },
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": {
                    "$concat": [
                      {
                        "$state": "/world/definition/initial/cycle"
                      },
                      " ·"
                    ]
                  },
                  "size": "sm"
                }
              },
              {
                "component": "Row",
                "repeat": {
                  "statePath": "/world/definition/phases"
                },
                "visible": {
                  "$index": true,
                  "eq": {
                    "$state": "/world/definition/initial/phase"
                  }
                },
                "children": [
                  {
                    "component": "Text",
                    "props": {
                      "content": {
                        "$item": ""
                      },
                      "size": "sm"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "component": "Grid",
        "visible": {
          "$state": "/world/definition/kind",
          "eq": "calendar"
        },
        "props": {
          "cols": 2
        },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": "Era",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$state": "/world/definition/calendar/era"
              },
              "size": "sm"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": "Months in a year",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$count": {
                  "$state": "/world/definition/calendar/months"
                }
              },
              "size": "sm"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": "Hours in a day",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$state": "/world/definition/calendar/hoursPerDay"
              },
              "size": "sm"
            }
          },
          {
            "component": "Text",
            "visible": {
              "$state": "/world/definition/calendar/weekdays"
            },
            "props": {
              "content": "Days of the week",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Grid",
            "visible": {
              "$state": "/world/definition/calendar/weekdays"
            },
            "repeat": {
              "statePath": "/world/definition/calendar/weekdays"
            },
            "props": {
              "cols": 2
            },
            "children": [
              {
                "component": "Badge",
                "props": { "label": { "$item": "" } }
              }
            ]
          },
          {
            "component": "Text",
            "props": {
              "content": "Starts at",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Row",
            "props": {
              "gap": "xs"
            },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": { "$state": "/world/definition/calendar/era" },
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": {
                    "$concat": [
                      {
                        "$state": "/world/definition/initial/year"
                      },
                      " · ",
                      {
                        "$state": "/world/definition/initial/month"
                      },
                      "/",
                      {
                        "$state": "/world/definition/initial/day"
                      },
                      " ",
                      {
                        "$format": "number",
                        "value": {
                          "$state": "/world/definition/initial/hour"
                        },
                        "options": {
                          "minimumIntegerDigits": 2
                        }
                      },
                      ":",
                      {
                        "$format": "number",
                        "value": {
                          "$state": "/world/definition/initial/minute"
                        },
                        "options": {
                          "minimumIntegerDigits": 2
                        }
                      }
                    ]
                  },
                  "size": "sm"
                }
              }
            ]
          }
        ]
      },
      {
        "component": "Grid",
        "props": {
          "cols": 2
        },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": "Time moves",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$map": {
                  "$state": "/world/definition/evolution/mode"
                },
                "labels": {
                  "forward": "Forward",
                  "backward": "Backward",
                  "bidirectional": "Forward or backward, as the story goes",
                  "random": "Jumps at random"
                }
              },
              "size": "sm"
            }
          },
          {
            "component": "Text",
            "visible": {
              "$state": "/world/definition/kind",
              "eq": "phases"
            },
            "props": {
              "content": "Default per turn, in phases",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "visible": {
              "$state": "/world/definition/kind",
              "eq": "calendar"
            },
            "props": {
              "content": "Default per turn, in minutes",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$format": "number",
                "value": {
                  "$state": "/world/definition/evolution/defaultStep"
                }
              },
              "size": "sm"
            }
          },
          {
            "component": "Text",
            "visible": {
              "$state": "/world/definition/kind",
              "eq": "phases"
            },
            "props": {
              "content": "Most per turn, in phases",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "visible": {
              "$state": "/world/definition/kind",
              "eq": "calendar"
            },
            "props": {
              "content": "Most per turn, in minutes",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$format": "number",
                "value": {
                  "$state": "/world/definition/evolution/maxStep"
                }
              },
              "size": "sm"
            }
          },
          {
            "component": "Text",
            "visible": {
              "$state": "/world/definition/evolution/mode",
              "eq": "random"
            },
            "props": {
              "content": "Random range",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Row",
            "visible": {
              "$state": "/world/definition/evolution/mode",
              "eq": "random"
            },
            "props": {
              "gap": "xs"
            },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": {
                    "$state": "/world/definition/evolution/randomRange/min"
                  },
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": "to",
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": {
                    "$state": "/world/definition/evolution/randomRange/max"
                  },
                  "size": "sm"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
