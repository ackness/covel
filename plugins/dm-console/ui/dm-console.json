{
  "id": "dm-console",
  "label": "Game Master Panel",
  "alwaysRender": true,
  "view": {
    "component": "Stack",
    "props": {
      "gap": "md"
    },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": "Use the input for your current role to guide the story or move it forward. Opening this panel does not change your role or who speaks next.",
          "variant": "muted",
          "size": "sm"
        }
      },
      {
        "component": "Section",
        "props": {
          "title": "Characters in the scene",
          "defaultOpen": true
        },
        "children": [
          {
            "component": "SceneCastList"
          }
        ]
      },
      {
        "component": "Section",
        "props": {
          "title": "Waiting for you",
          "defaultOpen": true
        },
        "children": [
          {
            "component": "SessionMessages",
            "props": {
              "content": "pending"
            }
          }
        ]
      },
      {
        "component": "Section",
        "props": {
          "title": "Story",
          "defaultOpen": true
        },
        "children": [
          {
            "component": "SessionMessages"
          }
        ]
      },
      {
        "component": "Section",
        "props": {
          "title": "Your input",
          "defaultOpen": true
        },
        "children": [
          {
            "component": "SessionComposer"
          }
        ]
      }
    ]
  }
}
