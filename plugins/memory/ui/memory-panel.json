{
  "id": "memory",
  "label": "Story Memory",
  "shortLabel": "Story Memory",
  "icon": "brain",
  "groupOrder": 800,
  "dataSource": { "namespace": "blocks" },
  "emptyState": {
    "message": "Nothing remembered yet. Notes appear after the first turn."
  },
  "view": {
    "component": "Stack",
    "props": { "gap": "sm" },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": "Updates after every turn with the key plot, scene and character details.",
          "size": "xs",
          "variant": "muted"
        }
      },
      {
        "component": "Accordion",
        "repeat": { "statePath": "/entries", "key": "key" },
        "children": [
          {
            "component": "Section",
            "props": {
              "title": { "$item": "value/displayName" },
              "icon": { "$item": "value/icon" },
              "defaultOpen": true
            },
            "children": [
              {
                "component": "Stack",
                "props": { "gap": "xs" },
                "children": [
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/content" },
                      "size": "sm"
                    }
                  },
                  {
                    "component": "Row",
                    "props": {
                      "justify": "between",
                      "align": "center",
                      "gap": "sm"
                    },
                    "children": [
                      {
                        "component": "Badge",
                        "props": {
                          "label": { "$item": "value/charCount" },
                          "color": "blue"
                        }
                      },
                      {
                        "component": "Text",
                        "visible": { "$item": "value/updatedAt" },
                        "props": {
                          "content": {
                            "$format": "date",
                            "value": { "$item": "value/updatedAt" },
                            "options": {
                              "month": "2-digit",
                              "day": "2-digit",
                              "hour": "2-digit",
                              "minute": "2-digit"
                            }
                          },
                          "size": "xs",
                          "variant": "muted"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
