{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "blocks"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "world"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "displayName", "extractionHint"],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "displayName": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "extractionHint": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "icon": {
            "type": "string"
          },
          "maxChars": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
