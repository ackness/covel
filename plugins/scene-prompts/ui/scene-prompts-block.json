{
  "id": "scene-prompts",
  "dataSource": { "namespace": "message" },
  "view": {
    "component": "Stack",
    "props": { "gap": "md" },
    "children": [
      {
        "component": "Row",
        "props": { "gap": "sm", "align": "baseline" },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": "SCENE PROMPTS",
              "variant": "muted",
              "size": "xs",
              "className": "ui-meta"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": { "$state": "/scene" },
              "weight": "bold",
              "size": "sm"
            }
          }
        ]
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "选择一个短句加入待发送区，再从底部统一发送。",
            "en": "Pick a prompt to queue it, then send from the composer below."
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 2 },
        "children": [
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "visible": { "$state": "/prompt1Text" },
            "children": [
              {
                "component": "Row",
                "props": { "gap": "xs", "align": "center" },
                "children": [
                  { "component": "Icon", "props": { "name": { "$state": "/prompt1Icon" }, "size": "xs" } },
                  { "component": "Badge", "props": { "label": { "$state": "/prompt1Label" }, "color": { "$state": "/prompt1Color" } } }
                ]
              },
              {
                "component": "Button",
                "props": { "label": { "$state": "/prompt1Text" }, "variant": "ghost", "size": "compact" },
                "on": { "click": { "action": "draftMessage", "params": { "text": { "$state": "/prompt1Text" }, "selectionGroup": "scene-prompts:1" } } }
              }
            ]
          },
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "visible": { "$state": "/prompt2Text" },
            "children": [
              {
                "component": "Row",
                "props": { "gap": "xs", "align": "center" },
                "children": [
                  { "component": "Icon", "props": { "name": { "$state": "/prompt2Icon" }, "size": "xs" } },
                  { "component": "Badge", "props": { "label": { "$state": "/prompt2Label" }, "color": { "$state": "/prompt2Color" } } }
                ]
              },
              {
                "component": "Button",
                "props": { "label": { "$state": "/prompt2Text" }, "variant": "ghost", "size": "compact" },
                "on": { "click": { "action": "draftMessage", "params": { "text": { "$state": "/prompt2Text" }, "selectionGroup": "scene-prompts:2" } } }
              }
            ]
          },
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "visible": { "$state": "/prompt3Text" },
            "children": [
              {
                "component": "Row",
                "props": { "gap": "xs", "align": "center" },
                "children": [
                  { "component": "Icon", "props": { "name": { "$state": "/prompt3Icon" }, "size": "xs" } },
                  { "component": "Badge", "props": { "label": { "$state": "/prompt3Label" }, "color": { "$state": "/prompt3Color" } } }
                ]
              },
              {
                "component": "Button",
                "props": { "label": { "$state": "/prompt3Text" }, "variant": "ghost", "size": "compact" },
                "on": { "click": { "action": "draftMessage", "params": { "text": { "$state": "/prompt3Text" }, "selectionGroup": "scene-prompts:3" } } }
              }
            ]
          },
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "visible": { "$state": "/prompt4Text" },
            "children": [
              {
                "component": "Row",
                "props": { "gap": "xs", "align": "center" },
                "children": [
                  { "component": "Icon", "props": { "name": { "$state": "/prompt4Icon" }, "size": "xs" } },
                  { "component": "Badge", "props": { "label": { "$state": "/prompt4Label" }, "color": { "$state": "/prompt4Color" } } }
                ]
              },
              {
                "component": "Button",
                "props": { "label": { "$state": "/prompt4Text" }, "variant": "ghost", "size": "compact" },
                "on": { "click": { "action": "draftMessage", "params": { "text": { "$state": "/prompt4Text" }, "selectionGroup": "scene-prompts:4" } } }
              }
            ]
          },
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "visible": { "$state": "/prompt5Text" },
            "children": [
              {
                "component": "Row",
                "props": { "gap": "xs", "align": "center" },
                "children": [
                  { "component": "Icon", "props": { "name": { "$state": "/prompt5Icon" }, "size": "xs" } },
                  { "component": "Badge", "props": { "label": { "$state": "/prompt5Label" }, "color": { "$state": "/prompt5Color" } } }
                ]
              },
              {
                "component": "Button",
                "props": { "label": { "$state": "/prompt5Text" }, "variant": "ghost", "size": "compact" },
                "on": { "click": { "action": "draftMessage", "params": { "text": { "$state": "/prompt5Text" }, "selectionGroup": "scene-prompts:5" } } }
              }
            ]
          },
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "visible": { "$state": "/prompt6Text" },
            "children": [
              {
                "component": "Row",
                "props": { "gap": "xs", "align": "center" },
                "children": [
                  { "component": "Icon", "props": { "name": { "$state": "/prompt6Icon" }, "size": "xs" } },
                  { "component": "Badge", "props": { "label": { "$state": "/prompt6Label" }, "color": { "$state": "/prompt6Color" } } }
                ]
              },
              {
                "component": "Button",
                "props": { "label": { "$state": "/prompt6Text" }, "variant": "ghost", "size": "compact" },
                "on": { "click": { "action": "draftMessage", "params": { "text": { "$state": "/prompt6Text" }, "selectionGroup": "scene-prompts:6" } } }
              }
            ]
          }
        ]
      },
      {
        "component": "Card",
        "props": { "variant": "subtle" },
        "children": [
          {
            "component": "Row",
            "props": { "gap": "sm", "align": "center" },
            "children": [
              { "component": "Icon", "props": { "name": "pen-line", "size": "xs" } },
              { "component": "Text", "props": { "content": { "zh": "自定义场景行动", "en": "Custom scene action" }, "weight": "bold", "size": "sm" } }
            ]
          },
          {
            "component": "Input",
            "props": {
              "placeholder": {
                "zh": "例如：我放低声音，问她刚才看见了什么",
                "en": "e.g. I lower my voice and ask what she just saw."
              },
              "value": { "$bindState": "/customText" }
            }
          },
          {
            "component": "Button",
            "props": { "label": { "zh": "加入待发送区", "en": "Queue" }, "variant": "ghost", "size": "compact" },
            "on": { "click": { "action": "draftMessage", "params": { "text": { "$bindState": "/customText" }, "selectionGroup": "scene-prompts:custom" } } }
          }
        ]
      }
    ]
  },
  "emptyState": {
    "message": {
      "zh": "场景提示会在新的叙事节点出现后显示在这里。",
      "en": "Scene prompts will appear here after the next narrative turn."
    }
  }
}
