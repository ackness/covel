{
  "id": "action-guide",
  "dataSource": {
    "namespace": "message"
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "md"
    },
    "children": [
      {
        "component": "Row",
        "props": {
          "gap": "sm",
          "align": "baseline"
        },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": "§ GUIDE",
              "variant": "muted",
              "size": "xs",
              "className": "ui-meta"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$state": "/topic"
              },
              "weight": "bold",
              "size": "sm"
            }
          }
        ]
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "选择建议后在底部发送，也可以在那里补充你自己的行动。",
            "en": "Choose a suggestion and send it below. You can add your own action in the same input."
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": {
          "cols": 1
        },
        "children": [
          {
            "component": "Card",
            "props": {
              "variant": "subtle"
            },
            "visible": {
              "$state": "/category1Label"
            },
            "children": [
              {
                "component": "Row",
                "props": {
                  "gap": "xs",
                  "align": "center"
                },
                "children": [
                  {
                    "component": "Icon",
                    "props": {
                      "name": {
                        "$state": "/category1Icon"
                      },
                      "size": "xs"
                    }
                  },
                  {
                    "component": "Badge",
                    "props": {
                      "label": {
                        "$state": "/category1Label"
                      },
                      "color": {
                        "$state": "/category1Color"
                      }
                    }
                  }
                ]
              },
              {
                "component": "Button",
                "visible": {
                  "$state": "/category1Suggestion1"
                },
                "props": {
                  "label": {
                    "$state": "/category1Suggestion1"
                  },
                  "variant": "ghost",
                  "size": "compact"
                },
                "on": {
                  "click": {
                    "action": "draftMessage",
                    "params": {
                      "text": {
                        "$state": "/category1Suggestion1"
                      },
                      "selectionGroup": "guide:category1"
                    }
                  }
                }
              },
