{
  "id": "guide",
  "dataSource": {
    "namespace": "message"
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "md"
    },
    "children": [
      {
        "component": "Row",
        "props": {
          "gap": "sm",
          "align": "baseline"
        },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": "SCENE PROMPTS",
              "variant": "muted",
              "size": "xs",
              "className": "ui-meta"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$state": "/scene"
              },
              "weight": "bold",
              "size": "sm"
            }
          }
        ]
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "$state": "/recap"
          },
          "variant": "muted",
          "size": "sm"
        },
        "visible": {
          "$state": "/recap"
        }
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "$state": "/decision"
          },
          "weight": "bold",
          "size": "sm"
        },
        "visible": {
          "$state": "/decision"
        }
      },
      {
        "component": "Text",
        "props": {
          "content": "Pick a prompt to queue it, then send from the composer below.",
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "ChoiceList",
        "children": [
          {
            "component": "Choice",
            "props": {
              "title": {
                "$state": "/prompt1Text"
              },
              "tag": {
                "$state": "/prompt1Label"
              },
              "tone": {
                "$state": "/prompt1Color"
              }
            },
            "visible": {
              "$state": "/prompt1Text"
            },
            "on": {
              "click": {
                "action": "draftMessage",
                "params": {
                  "text": {
                    "$state": "/prompt1Text"
                  },
                  "selectionGroup": "guide:1"
                }
              }
            }
          },
          {
            "component": "Choice",
            "props": {
              "title": {
                "$state": "/prompt2Text"
              },
              "tag": {
                "$state": "/prompt2Label"
              },
              "tone": {
                "$state": "/prompt2Color"
              }
            },
            "visible": {
              "$state": "/prompt2Text"
            },
            "on": {
              "click": {
                "action": "draftMessage",
                "params": {
                  "text": {
                    "$state": "/prompt2Text"
                  },
                  "selectionGroup": "guide:2"
                }
              }
            }
          },
          {
            "component": "Choice",
            "props": {
              "title": {
                "$state": "/prompt3Text"
              },
              "tag": {
                "$state": "/prompt3Label"
              },
              "tone": {
                "$state": "/prompt3Color"
              }
            },
            "visible": {
              "$state": "/prompt3Text"
            },
            "on": {
              "click": {
                "action": "draftMessage",
                "params": {
                  "text": {
                    "$state": "/prompt3Text"
                  },
                  "selectionGroup": "guide:3"
                }
              }
            }
          },
          {
            "component": "Choice",
            "props": {
              "title": {
                "$state": "/prompt4Text"
              },
              "tag": {
                "$state": "/prompt4Label"
              },
              "tone": {
                "$state": "/prompt4Color"
              }
            },
            "visible": {
              "$state": "/prompt4Text"
            },
            "on": {
              "click": {
                "action": "draftMessage",
                "params": {
                  "text": {
                    "$state": "/prompt4Text"
                  },
                  "selectionGroup": "guide:4"
                }
              }
            }
          },
          {
            "component": "Choice",
            "props": {
              "title": {
                "$state": "/prompt5Text"
              },
              "tag": {
                "$state": "/prompt5Label"
              },
              "tone": {
                "$state": "/prompt5Color"
              }
            },
            "visible": {
              "$state": "/prompt5Text"
            },
            "on": {
              "click": {
                "action": "draftMessage",
                "params": {
                  "text": {
                    "$state": "/prompt5Text"
                  },
                  "selectionGroup": "guide:5"
                }
              }
            }
          },
          {
            "component": "Choice",
            "props": {
              "title": {
                "$state": "/prompt6Text"
              },
              "tag": {
                "$state": "/prompt6Label"
              },
              "tone": {
                "$state": "/prompt6Color"
              }
            },
            "visible": {
              "$state": "/prompt6Text"
            },
            "on": {
              "click": {
                "action": "draftMessage",
                "params": {
                  "text": {
                    "$state": "/prompt6Text"
                  },
                  "selectionGroup": "guide:6"
                }
              }
            }
          }
        ]
      },
      {
        "component": "Card",
        "props": {
          "variant": "subtle"
        },
        "children": [
          {
            "component": "Row",
            "props": {
              "gap": "sm",
              "align": "center"
            },
            "children": [
              {
                "component": "Icon",
                "props": {
                  "name": "pen-line",
                  "size": "xs"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": "Custom scene action",
                  "weight": "bold",
                  "size": "sm"
                }
              }
            ]
          },
          {
            "component": "Input",
            "props": {
              "placeholder": "e.g. I lower my voice and ask what she just saw.",
              "value": {
                "$bindState": "/customText"
              }
            }
          },
          {
            "component": "Button",
            "props": {
              "label": "Queue",
              "variant": "ghost",
              "size": "compact"
            },
            "on": {
              "click": {
                "action": "draftMessage",
                "params": {
                  "text": {
                    "$bindState": "/customText"
                  },
                  "selectionGroup": "guide:custom"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "emptyState": {
    "message": "Scene prompts will appear here after the next narrative turn."
  }
}
