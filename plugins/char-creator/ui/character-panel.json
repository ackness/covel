{
  "id": "character",
  "group": "character",
  "groupLabel": "Characters",
  "groupOrder": 100,
  "label": "Characters",
  "icon": "users",
  "dataSource": {
    "source": "session.characters",
    "namespace": "characters"
  },
  "emptyState": {
    "message": "No characters created yet, complete the character creation flow to see them here…"
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "sm"
    },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": "All Characters",
          "weight": "bold",
          "size": "sm"
        }
      },
      {
        "component": "Separator"
      },
      {
        "component": "CardList",
        "repeat": {
          "statePath": "/entries",
          "key": "key"
        },
        "children": [
          {
            "component": "Card",
            "props": {
              "collapsible": true,
              "defaultExpanded": false
            },
            "children": [
              {
                "component": "Row",
                "props": {
                  "gap": "sm"
                },
                "children": [
                  {
                    "component": "CharacterAvatar",
                    "props": {
                      "characterId": {
                        "$item": "value/id"
                      },
                      "size": 28
                    }
                  },
                  {
                    "component": "Icon",
                    "props": {
                      "name": "user",
                      "size": "sm"
                    }
                  },
                  {
                    "component": "Text",
                    "props": {
                      "content": {
                        "$item": "value/name"
                      },
                      "weight": "bold",
                      "size": "sm"
                    }
                  },
                  {
                    "component": "Badge",
                    "props": {
                      "label": {
                        "$item": "value/type"
                      },
                      "color": "blue"
                    }
                  }
                ]
              },
              {
                "component": "TagList",
                "props": {
                  "tags": {
                    "$item": "value/aliases"
                  }
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": {
                    "$item": "value/description"
                  },
                  "variant": "muted",
                  "size": "xs"
                }
              },
              {
                "component": "CharacterFieldsView",
                "props": {
                  "value": {
                    "$item": "value/fields"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
