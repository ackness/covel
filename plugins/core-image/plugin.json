{
  "schemaVersion": "1.0",
  "id": "core-image",
  "displayName": {
    "zh-CN": "故事插画",
    "en-US": "Story Image"
  },
  "version": "0.2.0",
  "author": "covel",
  "description": {
    "zh-CN": "玩家点击后生成故事插画：LLM 优化提示词并调用图片模型生成插画",
    "en-US": "Player-triggered story illustration generation with LLM prompt enhancement and image model rendering"
  },
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en-US"],
  "loadingOrder": 70,
  "runtimes": [
    {
      "id": "image-generator",
      "pluginId": "core-image",
      "kind": "plugin",
      "priority": 700,
      "trigger": {
        "mode": "event",
        "onEvents": ["image.generation.requested"]
      },
      "providerTag": "text",
      "tools": [],
      "hooks": [],
      "budget": {
        "maxSteps": 1,
        "timeoutMs": 120000,
        "maxTokens": 2048
      }
    },
    {
      "id": "settings-updater",
      "pluginId": "core-image",
      "kind": "plugin",
      "priority": 200,
      "trigger": {
        "mode": "event",
        "onEvents": ["image.settings.updated"]
      },
      "tools": [],
      "hooks": []
    }
  ],
  "tools": [],
  "blockSchemas": [
    {
      "type": "story_image",
      "interactive": false,
      "meta": {
        "displayName": {
          "zh-CN": "故事插画",
          "en-US": "Story Image"
        },
        "description": "Story illustration display"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "imageId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["generating", "ready", "error"]
          },
          "originalPrompt": { "type": "string" },
          "enhancedPrompt": { "type": "string" },
          "isMultiScene": { "type": "boolean" },
          "stylePreset": { "type": "string" },
          "imageUrl": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    },
    {
      "type": "core_image_settings",
      "interactive": true,
      "uiSlot": "settings_panel",
      "meta": {
        "displayName": {
          "zh-CN": "插画生成设置",
          "en-US": "Image Generation Settings"
        },
        "description": "Configure style, layout and prompt language for image generation"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
            "enum": ["cinematic", "anime", "oil-painting", "watercolor", "pixel-art", "photoreal"],
            "default": "cinematic"
          },
          "multiPanel": {
            "type": "boolean",
            "default": false
          },
          "includeText": {
            "type": "boolean",
            "default": false
          },
          "promptLanguage": {
            "type": "string",
            "enum": ["auto", "zh", "en"],
            "default": "auto"
          }
        }
      }
    }
  ]
}
