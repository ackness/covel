{
  "id": "dice-check-results",
  "dataSource": { "namespace": "message" },
  "view": {
    "component": "Stack",
    "props": { "gap": "sm" },
    "children": [
      {
        "component": "Text",
        "visible": { "$state": "/rejectedCount" },
        "props": {
          "content": {
            "zh": "部分判定未通过校验。这里只展示与本回合骰子及规则一致的结果。",
            "en": "Some checks could not be verified. Only results consistent with this turn's dice and rules are shown."
          },
          "size": "sm"
        }
      },
      {
        "component": "Card",
        "props": { "variant": "subtle" },
        "repeat": { "statePath": "/checks", "key": "seq" },
        "children": [
          {
            "component": "Row",
            "props": { "gap": "sm", "align": "center" },
            "children": [
              {
                "component": "Text",
                "props": { "content": "🎲", "size": "sm" }
              },
              {
                "component": "Text",
                "props": {
                  "content": { "$item": "action" },
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": { "$item": "outcomeLabel" },
                  "color": { "$item": "outcomeColor" }
                }
              },
              {
                "component": "Icon",
                "visible": { "$item": "critical" },
                "props": { "name": "sparkles", "size": "xs" }
              }
            ]
          },
          {
            "component": "Row",
            "props": { "gap": "sm", "align": "center" },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": { "$item": "rollText" },
                  "variant": "muted",
                  "size": "xs"
                }
              },
              {
                "component": "Text",
                "visible": { "$item": "attribute" },
                "props": {
                  "content": { "$item": "attribute" },
                  "variant": "muted",
                  "size": "xs"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
