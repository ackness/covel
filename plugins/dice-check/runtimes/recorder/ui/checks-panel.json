{
  "id": "dice-check-panel",
  "label": "Roll log",
  "icon": "dices",
  "alwaysRender": true,
  "dataSource": { "namespace": "checks" },
  "emptyState": {
    "message": "No rolls yet. Results appear here when you try a risky action."
  },
  "view": {
    "component": "Stack",
    "props": { "gap": "sm" },
    "children": [
      {
        "component": "Card",
        "props": { "variant": "subtle" },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": "You can also type /roll in the chat, for example /roll 2d6.",
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Row",
            "props": { "gap": "sm", "align": "center" },
            "children": [
              {
                "component": "Button",
                "props": {
                  "label": "Roll d20",
                  "variant": "primary",
                  "size": "compact"
                },
                "on": {
                  "click": {
                    "action": "invokeCommand",
                    "params": {
                      "command": "roll",
                      "args": { "notation": "1d20" }
                    }
                  }
                }
              },
              {
                "component": "Button",
                "props": {
                  "label": "Roll 2d6",
                  "variant": "default",
                  "size": "compact"
                },
                "on": {
                  "click": {
                    "action": "invokeCommand",
                    "params": {
                      "command": "roll",
                      "args": { "notation": "2d6" }
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "component": "CardList",
        "repeat": { "statePath": "/entries", "key": "key" },
        "children": [
          {
            "component": "Card",
            "children": [
              {
                "component": "Row",
                "props": { "gap": "sm", "align": "center" },
                "children": [
                  {
                    "component": "Badge",
                    "props": {
                      "label": { "$item": "value/outcomeLabel" },
                      "color": { "$item": "value/outcomeColor" }
                    }
                  },
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/action" },
                      "weight": "bold",
                      "size": "sm"
                    }
                  },
                  {
                    "component": "Icon",
                    "visible": { "$item": "value/critical" },
                    "props": { "name": "sparkles", "size": "xs" }
                  }
                ]
              },
              {
                "component": "Row",
                "props": { "gap": "sm", "align": "center" },
                "children": [
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/rollText" },
                      "variant": "muted",
                      "size": "xs"
                    }
                  },
                  {
                    "component": "Text",
                    "visible": { "$item": "value/attributeLabel" },
                    "props": {
                      "content": { "$item": "value/attributeLabel" },
                      "variant": "muted",
                      "size": "xs"
                    }
                  }
                ]
              },
              {
                "component": "Text",
                "visible": { "$item": "value/turnLabel" },
                "props": {
                  "content": { "$item": "value/turnLabel" },
                  "variant": "muted",
                  "size": "xs"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
