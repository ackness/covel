{
  "id": "npc-graph",
  "group": "npc-graph",
  "label": { "zh": "关系图谱", "en": "Relationship Graph" },
  "icon": "network",
  "dataSource": { "namespace": "nodes" },
  "view": {
    "component": "Stack",
    "props": { "gap": "sm" },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "当前会话里的角色、群体与势力关系。绿线=正向关系，红线=负向关系，灰线=中立。点击节点查看档案。",
            "en": "Relationships among characters, groups, and factions in the current session. Green = positive, red = negative, gray = neutral."
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "GraphCanvas",
        "props": {
          "pluginId": "npc-graph",
          "nodesNamespace": "nodes",
          "edgesNamespace": "edges",
          "height": 480
        }
      }
    ]
  }
}
