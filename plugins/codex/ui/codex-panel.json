{
  "id": "codex",
  "group": "codex",
  "label": "Codex",
  "shortLabel": "Codex",
  "icon": "book-open",
  "groupOrder": 700,
  "dataSource": { "namespace": "entries" },
  "emptyState": {
    "message": "No codex entries yet. They will appear as the story continues…"
  },
  "view": {
    "component": "FilterContainer",
    "props": {
      "items": { "$state": "/entries" },
      "searchPlaceholder": "Search entries…",
      "searchFields": ["value/title", "value/content", "value/tags"],
      "filterField": "value/category",
      "showCounts": true,
      "filterTabs": [
        { "value": "all", "label": "All" },
        {
          "value": "monster",
          "label": "Monsters",
          "icon": "skull",
          "color": "red"
        },
        {
          "value": "item",
          "label": "Items",
          "icon": "gem",
          "color": "amber"
        },
        {
          "value": "location",
          "label": "Locations",
          "icon": "map-pin",
          "color": "blue"
        },
        {
          "value": "lore",
          "label": "Lore",
          "icon": "scroll-text",
          "color": "purple"
        },
        {
          "value": "character",
          "label": "Characters",
          "icon": "users",
          "color": "green"
        },
        {
          "value": "skill",
          "label": "Skills",
          "icon": "sparkles",
          "color": "cyan"
        }
      ],
      "itemComponent": "EntryCard",
      "itemKeyField": "key",
      "itemPropMap": {
        "title": "value/title",
        "category": "value/category",
        "content": "value/content",
        "tags": "value/tags",
        "rarity": "value/rarity",
        "icon": "value/categoryMeta/icon",
        "color": "value/categoryMeta/color",
        "isNew": "value/isNew"
      },
      "itemLiteralProps": {
        "collapsible": true,
        "defaultExpanded": false
      },
      "footer": "{{count}} entries collected",
      "emptyMessage": "No matching entries"
    }
  }
}
