{
  "id": "codex",
  "group": "codex",
  "label": { "zh": "知识图鉴", "en": "Codex" },
  "shortLabel": { "zh": "图鉴", "en": "Codex" },
  "icon": "book-open",
  "groupOrder": 700,
  "dataSource": { "namespace": "entries" },
  "emptyState": {
    "message": {
      "zh": "图鉴暂无词条，等待 narrator 发现新知识……",
      "en": "No codex entries yet, waiting for the narrator to uncover new knowledge…"
    }
  },
  "view": {
    "component": "FilterContainer",
    "props": {
      "items": { "$state": "/entries" },
      "searchPlaceholder": {
        "zh": "搜索词条…",
        "en": "Search entries…"
      },
      "searchFields": ["value/title", "value/content", "value/tags"],
      "filterField": "value/category",
      "showCounts": true,
      "filterTabs": [
        { "value": "all", "label": { "zh": "全部", "en": "All" } },
        {
          "value": "monster",
          "label": { "zh": "怪物", "en": "Monsters" },
          "icon": "skull",
          "color": "red"
        },
        {
          "value": "item",
          "label": { "zh": "物品", "en": "Items" },
          "icon": "gem",
          "color": "amber"
        },
        {
          "value": "location",
          "label": { "zh": "地点", "en": "Locations" },
          "icon": "map-pin",
          "color": "blue"
        },
        {
          "value": "lore",
          "label": { "zh": "传说", "en": "Lore" },
          "icon": "scroll-text",
          "color": "purple"
        },
        {
          "value": "character",
          "label": { "zh": "人物", "en": "Characters" },
          "icon": "users",
          "color": "green"
        },
        {
          "value": "skill",
          "label": { "zh": "技能", "en": "Skills" },
          "icon": "sparkles",
          "color": "cyan"
        }
      ],
      "itemComponent": "EntryCard",
      "itemKeyField": "key",
      "itemPropMap": {
        "title": "value/title",
        "category": "value/category",
        "content": "value/content",
        "tags": "value/tags",
        "rarity": "value/rarity",
        "icon": "value/categoryMeta/icon",
        "color": "value/categoryMeta/color",
        "isNew": "value/isNew"
      },
      "itemLiteralProps": {
        "collapsible": true,
        "defaultExpanded": false
      },
      "footer": {
        "zh": "共 {{count}} 条记录",
        "en": "{{count}} entries collected"
      },
      "emptyMessage": {
        "zh": "没有匹配的条目",
        "en": "No matching entries"
      }
    }
  }
}
