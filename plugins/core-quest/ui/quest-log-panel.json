{
  "id": "core-quest",
  "group": "core-quest",
  "label": "Quest Log",
  "shortLabel": "Quests",
  "icon": "scroll-text",
  "groupOrder": 720,
  "dataSource": { "namespace": "quests" },
  "emptyState": {
    "message": "No quests yet. They will appear when the narrative introduces explicit commissions or goals…"
  },
  "view": {
    "component": "FilterContainer",
    "props": {
      "items": { "$state": "/entries" },
      "searchPlaceholder": "Search quests…",
      "searchFields": ["value/name", "value/description", "value/giver"],
      "filterField": "value/status",
      "showCounts": true,
      "filterTabs": [
        { "value": "all", "label": "All" },
        {
          "value": "active",
          "label": "Active",
          "icon": "compass",
          "color": "blue"
        },
        {
          "value": "completed",
          "label": "Completed",
          "icon": "check-circle-2",
          "color": "green"
        },
        {
          "value": "failed",
          "label": "Failed",
          "icon": "x-circle",
          "color": "red"
        }
      ],
      "itemComponent": "EntryCard",
      "itemKeyField": "key",
      "itemPropMap": {
        "title": "value/name",
        "category": "value/status",
        "content": "value/description",
        "tags": "value/chips",
        "isNew": "value/isNew"
      },
      "itemLiteralProps": {
        "collapsible": true,
        "defaultExpanded": true
      },
      "footer": "{{count}} quests tracked",
      "emptyMessage": "No matching quests"
    }
  }
}
