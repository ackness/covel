{
  "schemaVersion": "1.0",
  "id": "core-quest",
  "displayName": {
    "zh-CN": "任务追踪",
    "en-US": "Quest Tracker"
  },
  "version": "0.1.0",
  "author": "covel",
  "description": {
    "zh-CN": "分析叙事文本，自动识别和追踪任务、目标及完成状态。",
    "en-US": "Analyze narrative to detect and track quests, objectives, and completion status."
  },
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en-US"],
  "loadingOrder": 55,
  "requires": ["core-char-tracker"],
  "runtimes": [
    {
      "id": "quest-tracker",
      "pluginId": "core-quest",
      "kind": "plugin",
      "priority": 650,
      "trigger": {
        "mode": "event",
        "onEvents": ["user.input"]
      },
      "providerTag": "text",
      "tools": [
        "core-quest:create-quest",
        "core-quest:update-quest",
        "core-quest:complete-objective",
        "core-quest:complete-quest",
        "core-quest:fail-quest"
      ],
      "hooks": [],
      "budget": {
        "maxSteps": 3,
        "timeoutMs": 30000,
        "maxToolCalls": 6
      }
    }
  ],
  "tools": [
    {
      "id": "create-quest",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "Quest title" },
          "description": { "type": "string", "description": "Quest description" },
          "type": { "type": "string", "enum": ["main", "side", "hidden"], "description": "Quest type" },
          "objectives": {
            "type": "array",
            "description": "List of quest objectives",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string", "description": "Objective description" },
                "optional": { "type": "boolean", "description": "Whether the objective is optional" }
              },
              "required": ["description"]
            }
          },
          "rewards": { "type": "string", "description": "Optional quest rewards description" },
          "giverNpcId": { "type": "string", "description": "NPC who gave the quest" }
        },
        "required": ["title", "description", "type", "objectives"]
      }
    },
    {
      "id": "update-quest",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "properties": {
          "questId": { "type": "string", "description": "ID of the quest to update" },
          "title": { "type": "string", "description": "Updated title" },
          "description": { "type": "string", "description": "Updated description" },
          "objectives": {
            "type": "array",
            "description": "Updated objectives list",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "completed": { "type": "boolean" },
                "optional": { "type": "boolean" }
              },
              "required": ["description"]
            }
          },
          "rewards": { "type": "string" }
        },
        "required": ["questId"]
      }
    },
    {
      "id": "complete-objective",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "properties": {
          "questId": { "type": "string", "description": "ID of the quest" },
          "objectiveId": { "type": "string", "description": "ID of the objective to complete" }
        },
        "required": ["questId", "objectiveId"]
      }
    },
    {
      "id": "complete-quest",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "properties": {
          "questId": { "type": "string", "description": "ID of the quest to complete" }
        },
        "required": ["questId"]
      }
    },
    {
      "id": "fail-quest",
      "kind": "mutate",
      "schema": {
        "type": "object",
        "properties": {
          "questId": { "type": "string", "description": "ID of the quest to fail" }
        },
        "required": ["questId"]
      }
    }
  ],
  "blockSchemas": [
    {
      "type": "quest_log",
      "interactive": false,
      "meta": {
        "displayName": { "zh-CN": "任务日志", "en-US": "Quest Log" },
        "description": "Display current quest status and objectives"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "quests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "type": { "type": "string", "enum": ["main", "side", "hidden"] },
                "status": { "type": "string", "enum": ["discovered", "active", "completed", "failed", "abandoned"] },
                "objectives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "description": { "type": "string" },
                      "completed": { "type": "boolean" },
                      "optional": { "type": "boolean" }
                    }
                  }
                },
                "rewards": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
