{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://character-blueprint/blueprints",
  "oneOf": [
    { "$ref": "#/$defs/blueprint" },
    {
      "type": "object",
      "required": ["blueprint"],
      "properties": {
        "blueprint": { "$ref": "#/$defs/blueprint" },
        "importedAt": { "type": "string" },
        "sourceWorldId": { "type": "string" },
        "sourceId": { "type": "string" },
        "instantiatedCharacterId": { "type": "string" }
      },
      "additionalProperties": true
    }
  ],
  "$defs": {
    "blueprint": {
      "type": "object",
      "required": ["schemaVersion", "id", "name"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "description": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "attributes": { "type": "object" },
        "persona": { "type": "object" },
        "instantiate": {
          "type": "object",
          "properties": {
            "characterId": { "type": "string", "minLength": 1 },
            "type": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
