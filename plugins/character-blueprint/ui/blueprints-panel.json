{
  "id": "character-blueprint",
  "label": {
    "zh": "预设角色",
    "en": "Preset Characters"
  },
  "shortLabel": {
    "zh": "预设",
    "en": "Presets"
  },
  "icon": "id-card",
  "group": "chat-mode",
  "groupLabel": {
    "zh": "对话",
    "en": "Chat Mode"
  },
  "groupOrder": 450,
  "dataSource": { "namespace": "blueprints" },
  "alwaysRender": true,
  "view": {
    "component": "Stack",
    "props": { "gap": "md" },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "提前保存重要人物资料，之后可以直接加入当前故事。",
            "en": "Save important character details ahead of time, then add them directly to the current story."
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 2 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "资料编号", "en": "Profile code" },
              "placeholder": {
                "zh": "留空自动生成短编号",
                "en": "Leave blank to create a short code"
              },
              "value": { "$bindState": "/form/id" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "名称", "en": "Name" },
              "placeholder": { "zh": "例如：神代澪", "en": "e.g. Lin Yue" },
              "value": { "$bindState": "/form/name" }
            }
          }
        ]
      },
      {
        "component": "Grid",
        "props": { "cols": 2 },
        "children": [
          {
            "component": "Select",
            "props": {
              "label": { "zh": "角色类型", "en": "Role" },
              "value": { "$bindState": "/form/role" },
              "options": [
                {
                  "value": "npc",
                  "label": { "zh": "配角", "en": "Supporting character" }
                },
                {
                  "value": "player",
                  "label": { "zh": "玩家", "en": "Player" }
                },
                {
                  "value": "companion",
                  "label": { "zh": "同伴", "en": "Companion" }
                }
              ]
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "角色编号", "en": "Character code" },
              "placeholder": {
                "zh": "留空使用资料编号",
                "en": "Leave blank to reuse the profile code"
              },
              "value": { "$bindState": "/form/characterId" }
            }
          }
        ]
      },
      {
        "component": "Textarea",
        "props": {
          "label": { "zh": "简介", "en": "Description" },
          "placeholder": {
            "zh": "一句话说明角色身份、气质和当前压力。",
            "en": "One sentence about role, personality, and current pressure."
          },
          "value": { "$bindState": "/form/description" },
          "rows": 3
        }
      },
      {
        "component": "Textarea",
        "props": {
          "label": { "zh": "性格摘要", "en": "Personality summary" },
          "placeholder": {
            "zh": "角色在故事里如何说话、如何隐藏情绪、想要什么。",
            "en": "How this character speaks, hides emotion, and what they want."
          },
          "value": { "$bindState": "/form/personaSummary" },
          "rows": 3
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 2 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "别名", "en": "Aliases" },
              "placeholder": { "zh": "用逗号分隔", "en": "Comma separated" },
              "value": { "$bindState": "/form/aliasesText" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "标签", "en": "Tags" },
              "placeholder": {
                "zh": "同学, 重要人物",
                "en": "classmate, romance-candidate"
              },
              "value": { "$bindState": "/form/tagsText" }
            }
          }
        ]
      },
      {
        "component": "Grid",
        "props": { "cols": 2 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "特质", "en": "Traits" },
              "placeholder": {
                "zh": "礼貌, 慢热, 责任感强",
                "en": "polite, cautious, responsible"
              },
              "value": { "$bindState": "/form/traitsText" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "目标", "en": "Goals" },
              "placeholder": {
                "zh": "完成刊物, 保住活动室",
                "en": "finish the issue, protect the room"
              },
              "value": { "$bindState": "/form/goalsText" }
            }
          }
        ]
      },
      {
        "component": "Grid",
        "props": { "cols": 2 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "声音风格", "en": "Voice" },
              "placeholder": {
                "zh": "说话轻，句子完整",
                "en": "quiet, precise sentences"
              },
              "value": { "$bindState": "/form/voice" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "动作风格", "en": "Style" },
              "placeholder": {
                "zh": "用整理纸张掩饰紧张",
                "en": "hides nerves by arranging papers"
              },
              "value": { "$bindState": "/form/style" }
            }
          }
        ]
      },
      {
        "component": "Grid",
        "props": { "cols": 3 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "社团/组织", "en": "Club / group" },
              "value": { "$bindState": "/form/club" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "班级/身份", "en": "Class / identity" },
              "value": { "$bindState": "/form/className" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "关系阶段", "en": "Relationship stage" },
              "placeholder": { "zh": "初识", "en": "stranger" },
              "value": { "$bindState": "/form/relationshipStage" }
            }
          }
        ]
      },
      {
        "component": "Switch",
        "props": {
          "label": {
            "zh": "导入后实例化为角色",
            "en": "Instantiate after import"
          },
          "checked": { "$bindState": "/instantiate" }
        }
      },
      {
        "component": "Button",
        "props": {
          "label": {
            "zh": "创建角色蓝图",
            "en": "Create blueprint"
          },
          "variant": "primary",
          "size": "compact"
        },
        "on": {
          "click": {
            "action": "invokeRuntime",
            "params": {
              "runtimeId": "character-blueprint",
              "payload": {
                "blueprintForm": { "$bindState": "/form" },
                "instantiate": { "$bindState": "/instantiate" }
              }
            }
          }
        }
      },
      {
        "component": "Separator"
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "完整资料导入",
            "en": "Full profile import"
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Textarea",
        "props": {
          "label": {
            "zh": "完整资料",
            "en": "Full profile"
          },
          "placeholder": "{ \"schemaVersion\": 1, \"id\": \"mentor-lin\", \"name\": \"Lin Yue\", \"role\": \"npc\" }",
          "value": { "$bindState": "/draftJson" },
          "rows": 6
        }
      },
      {
        "component": "Button",
        "props": {
          "label": {
            "zh": "从完整资料导入",
            "en": "Import full profile"
          },
          "variant": "primary",
          "size": "compact"
        },
        "on": {
          "click": {
            "action": "invokeRuntime",
            "params": {
              "runtimeId": "character-blueprint",
              "payload": {
                "blueprintJson": { "$bindState": "/draftJson" },
                "instantiate": { "$bindState": "/instantiate" }
              }
            }
          }
        }
      },
      {
        "component": "Separator"
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "已保存预设角色",
            "en": "Saved preset characters"
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "CharacterBlueprintList",
        "props": {
          "value": { "$state": "/entries" }
        }
      }
    ]
  }
}
