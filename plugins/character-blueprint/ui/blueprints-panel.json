{
  "id": "character-blueprint",
  "group": "character",
  "groupLabel": "Characters",
  "label": "Preset Characters",
  "shortLabel": "Presets",
  "icon": "id-card",
  "groupOrder": 100,
  "dataSource": {
    "namespace": "blueprints"
  },
  "emptyState": {
    "message": "This world ships no preset characters. The cast is authored in the world package (e.g. main-cast.json, imported via world-data)."
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "md"
    },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": "Preset characters that appear in this world (read-only).",
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "EntryList",
        "props": {
          "items": {
            "$state": "/entries"
          },
          "idField": "key",
          "titleField": "value.name",
          "descriptionFields": ["value.persona.summary", "value.description"],
          "badgeFields": ["value.role", "value.aliases", "value.tags"],
          "fields": [
            {
              "path": "value.attributes",
              "label": "Attributes"
            }
          ],
          "footerField": "value.id"
        }
      }
    ]
  }
}
