{
  "id": "character-presence",
  "label": "Character Portraits",
  "shortLabel": "Art",
  "icon": "image",
  "group": "character-art",
  "groupLabel": "Portraits",
  "groupOrder": 150,
  "dataSource": {
    "namespace": "presence"
  },
  "alwaysRender": true,
  "view": {
    "component": "PortraitGallery",
    "props": {
      "replaceAction": {
        "pluginId": "character-blueprint",
        "runtimeId": "character-blueprint/presence",
        "payload": {
          "action": "replacePortrait",
          "characterId": {
            "from": "item.characterId"
          },
          "ref": {
            "from": "upload"
          }
        }
      }
    }
  }
}
