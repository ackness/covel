{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:story-event.plan@1",
  "title": "Covel hidden story event plan v1",
  "description": "Follow-up hidden events proposed during play. story-events validates each plan, stores accepted events in its hidden planned bucket, and fires each at most once.",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "retire": {
      "description": "Pending planned events to withdraw.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "reason": {
      "description": "Why the plan changed, for debugging. Never shown to the narrator.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "when", "payload"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "title": {
          "description": "Optional public name shown once the event has fired.",
          "$ref": "#/$defs/text"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "payload": {
          "description": "What happens when the event fires: a brief for the narrator, not finished prose.",
          "$ref": "#/$defs/text"
        },
        "priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "condition": {
      "anyOf": [
        {
          "type": "object",
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/leaf"
        }
      ]
    },
    "leaf": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [{ "type": "string" }, { "type": "integer" }]
              }
            }
          ]
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "equals": {},
        "notEquals": {},
        "in": {
          "type": "array"
        },
        "gte": {
          "type": "number"
        },
        "gt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "exists": {
          "type": "boolean"
        },
        "revealed": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "Holds once this event has fired."
        },
        "turnsSinceGte": {
          "type": "integer",
          "minimum": 0
        },
        "turnsSinceLte": {
          "type": "integer",
          "minimum": 0
        },
        "turnGte": {
          "type": "integer",
          "minimum": 0,
          "description": "Holds from this session turn on."
        },
        "turnLte": {
          "type": "integer",
          "minimum": 0,
          "description": "Holds up to this session turn."
        }
      },
      "oneOf": [
        {
          "required": ["dimension"],
          "not": {
            "anyOf": [
              {
                "required": ["time"]
              },
              {
                "required": ["revealed"]
              },
              {
                "required": ["turnGte"]
              },
              {
                "required": ["turnLte"]
              }
            ]
          }
        },
        {
          "required": ["time"],
          "not": {
            "anyOf": [
              {
                "required": ["dimension"]
              },
              {
                "required": ["revealed"]
              },
              {
                "required": ["turnGte"]
              },
              {
                "required": ["turnLte"]
              }
            ]
          }
        },
        {
          "required": ["revealed"],
          "not": {
            "anyOf": [
              {
                "required": ["dimension"]
              },
              {
                "required": ["time"]
              },
              {
                "required": ["turnGte"]
              },
              {
                "required": ["turnLte"]
              }
            ]
          }
        },
        {
          "anyOf": [
            {
              "required": ["turnGte"]
            },
            {
              "required": ["turnLte"]
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": ["dimension"]
              },
              {
                "required": ["time"]
              },
              {
                "required": ["revealed"]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
