{
  "id": "scene-stage",
  "group": "scene-stage",
  "groupLabel": "Scene",
  "label": "Scene",
  "shortLabel": "Scene",
  "icon": "image",
  "groupOrder": 450,
  "dataSource": { "namespace": "stage" },
  "emptyState": {
    "message": "The scene will appear once the story gets going…"
  },
  "view": {
    "component": "Stack",
    "props": { "gap": "sm" },
    "children": [
      {
        "component": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": [
          {
            "component": "Text",
            "props": {
              "content": { "$state": "/current/name" },
              "weight": "bold",
              "size": "sm"
            }
          },
          {
            "component": "Badge",
            "props": {
              "label": { "$state": "/current/variantLabel" },
              "color": "blue"
            }
          }
        ]
      },
      {
        "component": "Text",
        "props": {
          "content": { "$state": "/current/sourceLabel" },
          "variant": "muted",
          "size": "xs"
        }
      }
    ]
  }
}
