{
  "id": "dialogue-line",
  "match": { "kind": "dialogue" },
  "reveal": { "mode": "segments" },
  "view": {
    "component": "Stack",
    "props": { "gap": "xs" },
    "children": [
      {
        "component": "Row",
        "props": { "gap": "sm", "align": "center" },
        "visible": { "$state": "/segment/speaker" },
        "children": [
          {
            "component": "CharacterAvatar",
            "props": {
              "characterId": { "$state": "/character/id" },
              "size": 32
            }
          },
          {
            "component": "Text",
            "props": {
              "content": { "$state": "/segment/speaker" },
              "variant": "accent",
              "weight": "bold"
            }
          }
        ]
      },
      {
        "component": "Prose",
        "props": { "content": { "$state": "/segment/text" } }
      }
    ]
  }
}
