{
  "id": "dialogue-line",
  "match": { "kind": "dialogue" },
  "view": {
    "component": "Row",
    "props": { "gap": "sm", "align": "start" },
    "children": [
      {
        "component": "CharacterAvatar",
        "props": { "characterId": { "$state": "/character/id" } }
      },
      {
        "component": "Stack",
        "props": { "gap": "sm" },
        "children": [
          {
            "component": "Badge",
            "props": { "label": { "$state": "/segment/speaker" } }
          },
          {
            "component": "Prose",
            "props": { "content": { "$state": "/segment/text" } }
          }
        ]
      }
    ]
  }
}
