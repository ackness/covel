{
  "id": "scene-cast",
  "label": {
    "zh": "场景演员",
    "en": "Scene Cast"
  },
  "shortLabel": {
    "zh": "演员",
    "en": "Cast"
  },
  "icon": "users-round",
  "group": "chat-mode",
  "groupLabel": {
    "zh": "对话",
    "en": "Chat Mode"
