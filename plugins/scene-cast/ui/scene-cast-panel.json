      },
      {
        "component": "SceneCastList",
        "props": {
          "speakers": { "$state": "/current/speakers" },
          "reason": { "$state": "/current/reason" },
          "reasonLabel": { "$state": "/current/reasonLabel" }
        }
      }
    ]
