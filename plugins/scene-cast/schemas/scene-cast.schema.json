{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contract:scene-cast@1",
  "title": "Covel active scene cast output v1",
  "type": "object",
  "required": ["activeCastContext", "speakers"],
  "properties": {
    "activeCastContext": { "type": "string" },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
