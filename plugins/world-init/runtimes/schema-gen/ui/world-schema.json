{
  "id": "world-schema",
  "group": "world-data",
  "groupLabel": "World Details",
  "shortLabel": "Details",
  "label": "Character Traits",
  "icon": "sliders-horizontal",
  "dataSource": { "namespace": "schema" },
  "emptyState": {
    "message": "Character traits are not ready yet. Waiting for the world to finish preparing…"
  },
  "view": {
    "component": "CardList",
    "repeat": { "statePath": "/attributes", "key": "id" },
    "children": [
      {
        "component": "Card",
        "children": [
          {
            "component": "Row",
            "props": { "gap": "sm" },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": { "$item": "name" },
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": { "$item": "type" },
                  "color": "blue"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": { "$item": "category" }
                }
              }
            ]
          },
          {
            "component": "Text",
            "props": {
              "content": { "$item": "id" },
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": { "$item": "description" },
              "variant": "muted",
              "size": "xs"
            }
          }
        ]
      }
    ]
  }
}
