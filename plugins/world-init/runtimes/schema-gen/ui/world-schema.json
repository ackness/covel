{
  "id": "world-schema",
  "group": "world-data",
  "groupLabel": "World Details",
  "shortLabel": "Details",
  "label": "Character Traits",
  "icon": "sliders-horizontal",
  "dataSource": { "source": "session.characterSchema" },
  "emptyState": {
    "message": "Character traits are not ready yet. Waiting for the world to finish preparing…"
  },
  "view": {
    "component": "CardList",
    "repeat": { "statePath": "/attributes", "key": "id" },
    "children": [
      {
        "component": "Card",
        "children": [
          {
            "component": "Row",
            "props": { "gap": "sm" },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": { "$item": "name" },
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": {
                    "$map": { "$item": "type" },
                    "labels": {
                      "string": "Text",
                      "number": "Number",
                      "boolean": "Boolean",
                      "enum": "Choice",
                      "array": "List",
                      "object": "Object",
                      "map": "Map"
                    }
                  },
                  "color": "blue"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": {
                    "$map": { "$item": "category" },
                    "labels": {
                      "stats": "Stats",
                      "bio": "Biography",
                      "abilities": "Abilities",
                      "equipment": "Equipment",
                      "social": "Social"
                    }
                  }
                }
              }
            ]
          },
          {
            "component": "Text",
            "props": {
              "content": { "$item": "id" },
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": { "$item": "description" },
              "variant": "muted",
              "size": "xs"
            }
          }
        ]
      }
    ]
  }
}
