{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "world-init/schema-gen output",
  "description": "Atomic character schema and dimension declaration initialization result.",
  "type": "object",
  "required": ["success", "attributeCount", "dimensionCount", "worldSchema"],
  "additionalProperties": false,
  "properties": {
    "success": {
      "type": "boolean",
      "const": true
    },
    "attributeCount": {
      "type": "integer",
      "minimum": 0
    },
    "worldSchema": {
      "type": "object",
      "required": ["types", "attributes"],
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "preGameDone": {
      "description": "Optional tool/guard completion signal. The agent finalizer moves it to RuntimeResult.completion before validating the public business output.",
      "type": "boolean",
      "const": true
    },
    "dimensionCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
