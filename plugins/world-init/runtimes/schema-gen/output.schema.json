{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "world-init/schema-gen output",
  "description": "Atomic character schema and dimension declaration initialization result.",
  "type": "object",
  "required": [
    "success",
    "attributeCount",
    "dimensionCount",
    "worldSchema",
    "preGameDone"
  ],
  "additionalProperties": false,
  "properties": {
    "success": {
      "type": "boolean",
      "const": true
    },
    "attributeCount": {
      "type": "integer",
      "minimum": 15
    },
    "worldSchema": {
      "type": "object",
      "required": ["types", "attributes"],
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "array",
          "minItems": 15,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "preGameDone": {
      "type": "boolean",
      "const": true
    },
    "dimensionCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
