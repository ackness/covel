{
  "schemaVersion": "1.0",
  "id": "core-guide",
  "displayName": {
    "zh-CN": "故事引导",
    "en-US": "Story Guide"
  },
  "version": "0.1.0",
  "author": "covel",
  "description": {
    "zh-CN": "在用户输入后，生成结构化的下一步选择面板。依赖角色追踪器的输出。",
    "en-US": "After user input, generate structured next-step choice panels. Depends on char-tracker output."
  },
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en-US"],
  "loadingOrder": 50,
  "requires": ["core-char-tracker"],
  "blockSchemas": [
    {
      "type": "choice_set",
      "interactive": true,
      "meta": {
        "displayName": { "zh-CN": "选择面板", "en-US": "Choice Panel" },
        "description": "Player choice options"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "hint": { "type": "string" }
              },
              "required": ["id", "label"]
            }
          }
        }
      }
    },
    {
      "type": "action_guide",
      "interactive": true,
      "meta": {
        "displayName": { "zh-CN": "行动建议", "en-US": "Action Guide" },
        "description": "Categorized action suggestions with styles (safe/aggressive/creative/wild)"
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "style": { "type": "string", "enum": ["safe", "aggressive", "creative", "wild"] },
                "label": { "type": "string" },
                "suggestions": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["style", "label", "suggestions"]
            }
          }
        },
        "required": ["topic", "categories"]
      },
      "submitSchema": {
        "type": "object",
        "properties": {
          "selectedSuggestion": { "type": "string", "description": "The suggestion text the player chose" },
          "customInput": { "type": "string", "description": "Player's own custom action input" }
        }
      }
    }
  ],
  "runtimes": [
    {
      "id": "guide",
      "pluginId": "core-guide",
      "kind": "plugin",
      "priority": 500,
      "trigger": {
        "mode": "event",
        "onEvents": ["user.input"]
      },
      "providerBinding": "fast",
      "tools": ["core-guide:generate-choices", "core-guide:generate-action-guide"],
      "hooks": [],
      "budget": {
        "maxSteps": 3,
        "timeoutMs": 15000,
        "maxToolCalls": 2
      }
    }
  ],
  "tools": [
    {
      "id": "generate-choices",
      "kind": "render",
      "schema": {
        "type": "object",
        "properties": {
          "topic": { "type": "string", "description": "A concise description of the decision point" },
          "options": {
            "type": "array",
            "description": "Custom choice options. If omitted, defaults will be used.",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "description": "Unique option ID" },
                "label": { "type": "string", "description": "Display text for this option" }
              },
              "required": ["label"]
            }
          }
        }
      }
    },
    {
      "id": "generate-action-guide",
      "kind": "render",
      "schema": {
        "type": "object",
        "properties": {
          "topic": { "type": "string", "description": "Concise description of the current situation" },
          "categories": {
            "type": "array",
            "description": "Categorized action suggestions grouped by style",
            "items": {
              "type": "object",
              "properties": {
                "style": { "type": "string", "enum": ["safe", "aggressive", "creative", "wild"], "description": "Suggestion style category" },
                "label": { "type": "string", "description": "Optional custom label for this category" },
                "suggestions": {
                  "type": "array",
                  "description": "1-4 actionable suggestions in this category",
                  "items": { "type": "string" },
                  "minItems": 1,
                  "maxItems": 4
                }
              },
              "required": ["style", "suggestions"]
            },
            "minItems": 1,
            "maxItems": 4
          }
        },
        "required": ["topic", "categories"]
      }
    }
  ]
}
