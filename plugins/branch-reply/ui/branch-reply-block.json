{
  "id": "branch-reply",
  "dataSource": {
    "namespace": "message"
  },
  "view": {
    "component": "CandidateList",
    "props": {
      "title": {
        "zh": "回复候选",
        "en": "Reply candidates"
      },
      "draftLabel": {
        "zh": "草稿",
        "en": "Draft"
      },
      "sendLabel": {
        "zh": "发送",
        "en": "Send"
      },
      "acceptLabel": {
        "zh": "采用",
        "en": "Accept"
      },
      "regenerateLabel": {
        "zh": "重生成",
        "en": "Regenerate"
      },
      "candidates": {
        "$state": "/candidates"
      },
      "contentField": "text",
      "turnId": {
        "$state": "/turnId"
      },
      "acceptedId": {
        "$state": "/acceptedCandidateId"
      },
      "hiddenWhen": {
        "field": "source",
        "equals": "original"
      },
      "detailFields": ["source", "runtimeId"],
      "acceptAction": {
        "pluginId": "branch-reply",
        "runtimeId": "branch-reply",
        "payload": {
          "action": "acceptCandidate",
          "turnId": {
            "from": "props.turnId"
          },
          "candidateId": {
            "from": "item.id"
          }
        }
      },
      "regenerateAction": {
        "pluginId": "branch-reply",
        "runtimeId": "branch-reply",
        "payload": {
          "action": "createCandidates",
          "turnId": {
            "from": "props.turnId"
          },
          "baseText": {
            "from": "props.candidates.0.text"
          },
          "count": 3
        }
      }
    }
  }
}
