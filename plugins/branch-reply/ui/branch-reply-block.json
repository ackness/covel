{
  "id": "branch-reply",
  "dataSource": {
    "namespace": "message"
  },
  "view": {
    "component": "CandidateList",
    "props": {
      "title": "Reply candidates",
      "draftLabel": "Draft",
      "sendLabel": "Send",
      "acceptLabel": "Accept",
      "regenerateLabel": "Regenerate",
      "candidates": {
        "$state": "/candidates"
      },
      "contentField": "text",
      "turnId": {
        "$state": "/turnId"
      },
      "acceptedId": {
        "$state": "/acceptedCandidateId"
      },
      "hiddenWhen": {
        "field": "source",
        "equals": "original"
      },
      "detailFields": ["source", "runtimeId"],
      "acceptAction": {
        "pluginId": "branch-reply",
        "runtimeId": "branch-reply",
        "payload": {
          "action": "acceptCandidate",
          "turnId": {
            "from": "props.turnId"
          },
          "candidateId": {
            "from": "item.id"
          }
        }
      },
      "regenerateAction": {
        "pluginId": "branch-reply",
        "runtimeId": "branch-reply",
        "payload": {
          "action": "createCandidates",
          "turnId": {
            "from": "props.turnId"
          },
          "baseText": {
            "from": "props.candidates.0.text"
          },
          "count": 3
        }
      }
    }
  }
}
