{
  "id": "character-presence",
  "label": {
    "zh": "角色立绘",
    "en": "Character Portraits"
  },
  "shortLabel": {
    "zh": "立绘",
    "en": "Art"
  },
  "icon": "image",
  "group": "character-art",
  "groupLabel": {
    "zh": "角色立绘",
    "en": "Portraits"
  },
  "groupOrder": 150,
  "dataSource": { "namespace": "presence" },
  "alwaysRender": true,
  "view": {
    "component": "Stack",
    "props": { "gap": "md" },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "保存角色的头像、立绘和声音，让人物在故事中更鲜明。",
            "en": "Save portraits, character art, and voice details so the character feels more vivid in the story."
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 3 },
        "repeat": { "statePath": "/entries", "key": "key" },
        "children": [
          {
            "component": "Stack",
            "props": { "gap": "xs" },
            "children": [
              {
                "component": "Image",
                "props": {
                  "ref": { "$item": "value/avatar" },
                  "alt": { "$item": "value/displayName" },
                  "aspectRatio": "3/4",
                  "rounded": "md",
                  "fit": "cover"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": { "$item": "value/displayName" },
                  "size": "xs",
                  "variant": "muted"
                }
              }
            ]
          }
        ]
      },
      {
        "component": "Separator"
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "手动管理（可选）",
            "en": "Manual management (optional)"
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 2 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "角色编号", "en": "Character code" },
              "placeholder": {
                "zh": "留空自动生成短编号",
                "en": "Leave blank to create a short code"
              },
              "value": { "$bindState": "/form/characterId" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "显示名", "en": "Display name" },
              "placeholder": { "zh": "例如：林月", "en": "e.g. Lin Yue" },
              "value": { "$bindState": "/form/displayName" }
            }
          }
        ]
      },
      {
        "component": "Textarea",
        "props": {
          "label": { "zh": "表现风格", "en": "Presence style" },
          "placeholder": {
            "zh": "立绘偏安静，语音轻声，紧张时视线会避开玩家。",
            "en": "Quiet sprite direction, soft voice, avoids eye contact when nervous."
          },
          "value": { "$bindState": "/form/style" },
          "rows": 3
        }
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "头像",
            "en": "Portrait"
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 3 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "头像编号", "en": "Portrait code" },
              "value": { "$bindState": "/form/avatarId" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "文件类型", "en": "File type" },
              "placeholder": { "zh": "例如：图片", "en": "e.g. image/png" },
              "value": { "$bindState": "/form/avatarMime" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "大小", "en": "Size" },
              "placeholder": { "zh": "1234", "en": "1234" },
              "value": { "$bindState": "/form/avatarSize" }
            }
          }
        ]
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "立绘",
            "en": "Character art"
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 3 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "立绘编号", "en": "Character art code" },
              "value": { "$bindState": "/form/spriteId" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "文件类型", "en": "File type" },
              "placeholder": { "zh": "例如：图片", "en": "e.g. image/png" },
              "value": { "$bindState": "/form/spriteMime" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "大小", "en": "Size" },
              "value": { "$bindState": "/form/spriteSize" }
            }
          }
        ]
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "声音",
            "en": "Voice"
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Grid",
        "props": { "cols": 3 },
        "children": [
          {
            "component": "Input",
            "props": {
              "label": { "zh": "声音编号", "en": "Voice code" },
              "value": { "$bindState": "/form/voiceId" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "文件类型", "en": "File type" },
              "placeholder": { "zh": "例如：声音", "en": "e.g. audio/wav" },
              "value": { "$bindState": "/form/voiceMime" }
            }
          },
          {
            "component": "Input",
            "props": {
              "label": { "zh": "大小", "en": "Size" },
              "value": { "$bindState": "/form/voiceSize" }
            }
          }
        ]
      },
      {
        "component": "Button",
        "props": {
          "label": {
            "zh": "保存展示",
            "en": "Save display"
          },
          "variant": "primary",
          "size": "compact"
        },
        "on": {
          "click": {
            "action": "invokeRuntime",
            "params": {
              "runtimeId": "character-presence",
              "payload": {
                "presenceForm": { "$bindState": "/form" }
              }
            }
          }
        }
      },
      {
        "component": "Separator"
      },
      {
        "component": "Text",
        "props": {
          "content": {
            "zh": "完整资料导入",
            "en": "Full profile import"
          },
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "Textarea",
        "props": {
          "label": {
            "zh": "完整资料",
            "en": "Full profile"
          },
          "placeholder": "{ \"schemaVersion\": 1, \"characterId\": \"mentor-lin\", \"avatar\": { \"id\": \"...\", \"mime\": \"image/png\", \"size\": 1234 } }",
          "value": { "$bindState": "/draftJson" },
          "rows": 10
        }
      },
      {
        "component": "Button",
        "props": {
          "label": {
            "zh": "从完整资料导入",
            "en": "Import full profile"
          },
          "variant": "primary",
          "size": "compact"
        },
        "on": {
          "click": {
            "action": "invokeRuntime",
            "params": {
              "runtimeId": "character-presence",
              "payload": {
                "presenceJson": { "$bindState": "/draftJson" }
              }
            }
          }
        }
      }
    ]
  }
}
