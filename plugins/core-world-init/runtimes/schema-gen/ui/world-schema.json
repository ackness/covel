{
  "id": "world-schema",
  "group": "world-data",
  "groupLabel": { "zh": "世界维度", "en": "World Data" },
  "label": { "zh": "属性", "en": "Schema" },
  "icon": "sliders-horizontal",
  "dataSource": { "namespace": "schema" },
  "emptyState": { "message": { "zh": "角色属性定义尚未生成，等待世界初始化……", "en": "Character attribute schema not yet generated, waiting for world init…" } },
  "view": {
    "component": "CardList",
    "repeat": { "statePath": "/character-attributes/attributes", "key": "id" },
    "children": [
      {
        "component": "Card",
        "children": [
          {
            "component": "Row",
            "props": { "gap": "sm" },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": { "$item": "name" },
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": { "$item": "type" },
                  "color": "blue"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": { "$item": "category" }
                }
              }
            ]
          },
          {
            "component": "Text",
            "props": {
              "content": { "$item": "id" },
              "variant": "muted",
              "size": "xs"
            }
          },
          {
            "component": "Text",
            "props": {
              "content": { "$item": "description" },
              "variant": "muted",
              "size": "xs"
            }
          }
        ]
      }
    ]
  }
}
