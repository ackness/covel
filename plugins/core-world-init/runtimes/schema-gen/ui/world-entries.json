{
  "id": "world-entries",
  "group": "world-data",
  "groupLabel": { "zh": "世界维度", "en": "World Data" },
  "label": { "zh": "词条", "en": "Entries" },
  "icon": "book-marked",
  "dataSource": { "namespace": "entries" },
  "view": {
    "component": "Accordion",
    "repeat": { "statePath": "/entries", "key": "key" },
    "children": [
      {
        "component": "Section",
        "props": {
          "title": { "$item": "key" }
        },
        "children": [
          {
            "component": "JsonView",
            "props": {
              "value": { "$item": "value" }
            }
          }
        ]
      }
    ]
  }
}
