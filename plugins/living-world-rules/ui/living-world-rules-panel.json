{
  "id": "living-world-rules",
  "group": "world-data",
  "groupLabel": "World Details",
  "label": "World Rules",
  "shortLabel": "Rules",
  "icon": "book-marked",
  "groupOrder": 300,
  "dataSource": {
    "namespace": "rules"
  },
  "emptyState": {
    "message": "This world declares no lasting rules. Rules are authored in the world package (imported via world-data)."
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "md"
    },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": "Lasting setting rules and taboos in effect for this world (read-only).",
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "FilterContainer",
        "props": {
          "items": {
            "$state": "/entries"
          },
          "itemKeyField": "key",
          "emptyMessage": "No rules",
          "itemTemplate": {
            "component": "EntryCard",
            "props": {
              "collapsible": true,
              "defaultExpanded": false,
              "categoryOptions": [
                {
                  "value": "constant",
                  "label": "Constant"
                },
                {
                  "value": "triggered",
                  "label": "Triggered"
                },
                {
                  "value": "evolving",
                  "label": "Evolving"
                }
              ],
              "title": {
                "$item": "value/title"
              },
              "content": {
                "$item": "value/content"
              },
              "category": {
                "$item": "value/kind"
              }
            }
          }
        }
      }
    ]
  }
}
