{
  "id": "living-world-rules",
  "group": "world-data",
  "groupLabel": "World Details",
  "label": "World Rules",
  "shortLabel": "Rules",
  "icon": "book-marked",
  "groupOrder": 300,
  "dataSource": { "namespace": "rules" },
  "emptyState": {
    "message": "This world declares no lasting rules. Rules are authored in the world package (imported via world-data)."
  },
  "view": {
    "component": "Stack",
    "props": { "gap": "md" },
    "children": [
      {
        "component": "Text",
        "props": {
          "content": "Lasting setting rules and taboos in effect for this world (read-only).",
          "variant": "muted",
          "size": "xs"
        }
      },
      {
        "component": "FilterContainer",
        "props": {
          "items": { "$state": "/entries" },
          "itemComponent": "EntryCard",
          "itemKeyField": "key",
          "itemPropMap": {
            "title": "value/title",
            "content": "value/content",
            "category": "value/kind"
          },
          "itemLiteralProps": {
            "collapsible": true,
            "defaultExpanded": false
          },
          "emptyMessage": "No rules"
        }
      }
    ]
  }
}
