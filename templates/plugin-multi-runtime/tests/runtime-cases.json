{
  "$schema": "https://raw.githubusercontent.com/AcKnEsS/covel/main/packages/shared/schemas/runtime-cases.schema.json",
  "cases": [
    {
      "name": "manual-note-writes-plugin-data",
      "runtimeId": "{{pluginName}}/note",
      "payload": {
        "title": "Test checkpoint",
        "text": "The template runtime records deterministic plugin state.",
        "tags": ["template"]
      },
      "expect": {
        "runtimeResults": [
          {
            "runtimeId": "{{pluginName}}/note",
            "status": "success"
          }
        ],
        "pluginData": [
          {
            "namespace": "notes",
            "field": "title"
          }
        ],
        "logs": ["note.recorded"]
      }
    },
    {
      "name": "analyst-records-one-note",
      "runtimeId": "{{pluginName}}/analyst",
      "message": "The player promised the gatekeeper to return before dawn.",
      "llmResponses": [
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-record-analysis",
              "name": "notes-upsert",
              "arguments": "{\"record\":{\"id\":\"analysis-test\",\"kind\":\"analysis\",\"title\":\"Gatekeeper promise\",\"text\":\"The player promised the gatekeeper to return before dawn.\",\"tags\":[\"promise\"]}}"
            }
          ]
        },
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-submit",
              "name": "submit-output",
              "arguments": "{}"
            }
          ]
        }
      ],
      "expect": {
        "runtimeResults": [
          {
            "runtimeId": "{{pluginName}}/analyst",
            "status": "success"
          }
        ],
        "pluginData": [
          {
            "namespace": "notes",
            "key": "analysis-test",
            "field": "title"
          }
        ]
      }
    },
    {
      "name": "agent-no-change-submits-empty-output",
      "runtimeId": "{{pluginName}}/analyst",
      "message": "Nothing new happened.",
      "ignoreUpstreams": true,
      "llmResponses": [
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "final",
              "name": "submit-output",
              "arguments": "{}"
            }
          ]
        }
      ],
      "expect": {
        "runtimeResults": [
          {
            "runtimeId": "{{pluginName}}/analyst",
            "status": "success"
          }
        ]
      }
    },
    {
      "name": "agent-corrects-final-submission-without-repeating-write",
      "runtimeId": "{{pluginName}}/analyst",
      "message": "The player promised the gatekeeper to return before dawn.",
      "llmResponses": [
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-record-analysis",
              "name": "notes-upsert",
              "arguments": "{\"record\":{\"id\":\"analysis-test\",\"kind\":\"analysis\",\"title\":\"Gatekeeper promise\",\"text\":\"The player promised the gatekeeper to return before dawn.\",\"tags\":[\"promise\"]}}"
            }
          ]
        },
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "invalid-final",
              "name": "submit-output",
              "arguments": "[]"
            }
          ]
        },
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-submit",
              "name": "submit-output",
              "arguments": "{}"
            }
          ]
        }
      ],
      "expect": {
        "runtimeResults": [
          {
            "runtimeId": "{{pluginName}}/analyst",
            "status": "success"
          }
        ],
        "pluginData": [
          {
            "namespace": "notes",
            "key": "analysis-test",
            "field": "title"
          }
        ]
      }
    }
  ]
}
