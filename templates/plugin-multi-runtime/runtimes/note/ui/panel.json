{
  "id": "{{pluginName}}-notes",
  "group": "{{pluginName}}",
  "groupLabel": "{{pluginName}}",
  "groupOrder": 800,
  "label": "Plugin Notes",
  "shortLabel": "Notes",
  "icon": "notebook-pen",
  "dataSource": { "namespace": "notes" },
  "alwaysRender": true,
  "emptyState": {
    "message": "No plugin notes yet. Add a manual note or ask the analyst runtime to inspect the current narrative."
  },
  "view": {
    "component": "Stack",
    "props": { "gap": "md" },
    "children": [
      {
        "component": "Card",
        "props": { "variant": "subtle" },
        "children": [
          {
            "component": "Stack",
            "props": { "gap": "sm" },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": "{{pluginName}} plugin workbench",
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": "The function runtime writes deterministic notes; the agent runtime reads the narrative and records one observation. Replace the notes schema with your real plugin state.",
                  "variant": "muted",
                  "size": "xs"
                }
              },
              {
                "component": "Row",
                "props": { "gap": "sm" },
                "children": [
                  {
                    "component": "Button",
                    "props": {
                      "label": "Add note",
                      "variant": "primary",
                      "size": "md"
                    },
                    "on": {
                      "click": {
                        "action": "invokeRuntime",
                        "params": {
                          "runtimeId": "{{pluginName}}/note",
                          "payload": {
                            "title": "Manual checkpoint",
                            "text": "Replace this with state captured from your UI.",
                            "tags": ["manual"]
                          }
                        }
                      }
                    }
                  },
                  {
                    "component": "Button",
                    "props": {
                      "label": "Analyze scene",
                      "variant": "default",
                      "size": "md"
                    },
                    "on": {
                      "click": {
                        "action": "invokeRuntime",
                        "params": {
                          "runtimeId": "{{pluginName}}/analyst"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      { "component": "Separator" },
      {
        "component": "Stack",
        "props": { "gap": "xs" },
        "repeat": { "statePath": "/entries", "key": "key" },
        "children": [
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "children": [
              {
                "component": "Stack",
                "props": { "gap": "xs" },
                "children": [
                  {
                    "component": "Row",
                    "props": { "gap": "xs", "align": "center" },
                    "children": [
                      {
                        "component": "Badge",
                        "props": {
                          "label": { "$item": "value/kind" },
                          "color": "blue"
                        }
                      },
                      {
                        "component": "Text",
                        "props": {
                          "content": { "$item": "value/createdAt" },
                          "variant": "muted",
                          "size": "xs"
                        }
                      }
                    ]
                  },
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/title" },
                      "weight": "bold",
                      "size": "sm"
                    }
                  },
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/text" },
                      "size": "sm"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
