{
  "id": "{{pluginName}}-notes",
  "group": "{{pluginName}}",
  "groupLabel": { "zh": "{{pluginName}}", "en": "{{pluginName}}" },
  "groupOrder": 800,
  "label": { "zh": "插件记录", "en": "Plugin Notes" },
  "shortLabel": { "zh": "记录", "en": "Notes" },
  "icon": "notebook-pen",
  "dataSource": { "namespace": "notes" },
  "alwaysRender": true,
  "emptyState": {
    "message": {
      "zh": "还没有插件记录。可以手动添加一条记录，或让 analyst runtime 分析当前剧情。",
      "en": "No plugin notes yet. Add a manual note or ask the analyst runtime to inspect the current narrative."
    }
  },
  "view": {
    "component": "Stack",
    "props": { "gap": "md" },
    "children": [
      {
        "component": "Card",
        "props": { "variant": "subtle" },
        "children": [
          {
            "component": "Stack",
            "props": { "gap": "sm" },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": {
                    "zh": "{{pluginName}} 插件工作台",
                    "en": "{{pluginName}} plugin workbench"
                  },
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": {
                    "zh": "函数 runtime 写入确定性记录；agent runtime 读取剧情并写入一条观察。把 notes schema 换成你的真实插件状态即可继续开发。",
                    "en": "The function runtime writes deterministic notes; the agent runtime reads the narrative and records one observation. Replace the notes schema with your real plugin state."
                  },
                  "variant": "muted",
                  "size": "xs"
                }
              },
              {
                "component": "Row",
                "props": { "gap": "sm" },
                "children": [
                  {
                    "component": "Button",
                    "props": {
                      "label": { "zh": "添加记录", "en": "Add note" },
                      "variant": "primary",
                      "size": "md"
                    },
                    "on": {
                      "click": {
                        "action": "invokeRuntime",
                        "params": {
                          "runtimeId": "{{pluginName}}/note",
                          "payload": {
                            "title": "Manual checkpoint",
                            "text": "Replace this with state captured from your UI.",
                            "tags": ["manual"]
                          }
                        }
                      }
                    }
                  },
                  {
                    "component": "Button",
                    "props": {
                      "label": { "zh": "分析剧情", "en": "Analyze scene" },
                      "variant": "default",
                      "size": "md"
                    },
                    "on": {
                      "click": {
                        "action": "invokeRuntime",
                        "params": {
                          "runtimeId": "{{pluginName}}/analyst"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      { "component": "Separator" },
      {
        "component": "Stack",
        "props": { "gap": "xs" },
        "repeat": { "statePath": "/entries", "key": "key" },
        "children": [
          {
            "component": "Card",
            "props": { "variant": "subtle" },
            "children": [
              {
                "component": "Stack",
                "props": { "gap": "xs" },
                "children": [
                  {
                    "component": "Row",
                    "props": { "gap": "xs", "align": "center" },
                    "children": [
                      {
                        "component": "Badge",
                        "props": {
                          "label": { "$item": "value/kind" },
                          "color": "blue"
                        }
                      },
                      {
                        "component": "Text",
                        "props": {
                          "content": { "$item": "value/createdAt" },
                          "variant": "muted",
                          "size": "xs"
                        }
                      }
                    ]
                  },
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/title" },
                      "weight": "bold",
                      "size": "sm"
                    }
                  },
                  {
                    "component": "Text",
                    "props": {
                      "content": { "$item": "value/text" },
                      "size": "sm"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
