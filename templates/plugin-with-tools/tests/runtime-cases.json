{
  "$schema": "https://raw.githubusercontent.com/AcKnEsS/covel/main/packages/shared/schemas/runtime-cases.schema.json",
  "cases": [
    {
      "name": "agent-records-note-with-local-tool",
      "runtimeId": "{{pluginName}}",
      "message": "The player opened the sealed vault and found a silver key.",
      "ignoreUpstreams": true,
      "llmResponses": [
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-record-note",
              "name": "record-note",
              "arguments": "{\"title\":\"Opened vault\",\"text\":\"The player opened the sealed vault and found a silver key.\",\"tags\":[\"quest\"]}"
            }
          ]
        },
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-submit",
              "name": "submit-output",
              "arguments": "{}"
            }
          ]
        }
      ],
      "expect": {
        "runtimeResults": [
          {
            "runtimeId": "{{pluginName}}",
            "status": "success"
          }
        ],
        "pluginData": [
          {
            "namespace": "notes",
            "field": "title"
          }
        ]
      }
    },
    {
      "name": "agent-no-change-submits-empty-output",
      "runtimeId": "{{pluginName}}",
      "message": "Nothing new happened.",
      "ignoreUpstreams": true,
      "llmResponses": [
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "final",
              "name": "submit-output",
              "arguments": "{}"
            }
          ]
        }
      ],
      "expect": {
        "runtimeResults": [
          {
            "runtimeId": "{{pluginName}}",
            "status": "success"
          }
        ]
      }
    },
    {
      "name": "agent-corrects-final-submission-without-repeating-write",
      "runtimeId": "{{pluginName}}",
      "message": "The player opened the sealed vault and found a silver key.",
      "ignoreUpstreams": true,
      "llmResponses": [
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-record-note",
              "name": "record-note",
              "arguments": "{\"title\":\"Opened vault\",\"text\":\"The player opened the sealed vault and found a silver key.\",\"tags\":[\"quest\"]}"
            }
          ]
        },
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "invalid-final",
              "name": "submit-output",
              "arguments": "[]"
            }
          ]
        },
        {
          "content": null,
          "finishReason": "tool_calls",
          "toolCalls": [
            {
              "id": "tc-submit",
              "name": "submit-output",
              "arguments": "{}"
            }
          ]
        }
      ],
      "expect": {
        "runtimeResults": [
          {
            "runtimeId": "{{pluginName}}",
            "status": "success"
          }
        ],
        "pluginData": [
          {
            "namespace": "notes",
            "field": "title"
          }
        ]
      }
    }
  ]
}
