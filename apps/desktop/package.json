{
  "name": "@covel/desktop",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackness/covel.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx src/zip-extract.selfcheck.ts && tsx src/trusted-origin.selfcheck.ts",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "clean": "node ../../scripts/remove-paths.mjs dist staging ../../release/electron"
  },
  "dependencies": {
    "@covel/web": "workspace:*",
    "smol-toml": "^1.6.1",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
