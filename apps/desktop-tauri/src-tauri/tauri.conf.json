{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Covel",
  "version": "0.0.1-beta",
  "identifier": "com.covel.app.tauri",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../splash",
    "devUrl": null
  },
  "app": {
    "windows": [
      {
        "title": "Covel",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server": "server",
      "resources/web-dist": "web-dist",
      "binaries/node": "bin/node"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
