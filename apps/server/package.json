{
  "name": "@covel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --env-file=../../.env.llm src/index.ts",
    "dev:pg": "tsx watch --env-file=../../.env --env-file=../../.env.llm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@covel/ai-provider": "workspace:*",
    "@covel/context": "workspace:*",
    "@covel/event-bus": "workspace:*",
    "@covel/kernel": "workspace:*",
    "@covel/plugin-manager": "workspace:*",
    "@covel/plugin-runtime": "workspace:*",
    "@covel/runtime": "workspace:*",
    "@covel/runtime-context": "workspace:*",
    "@covel/services": "workspace:*",
    "@covel/shared": "workspace:*",
    "@covel/store": "workspace:*",
    "@hono/node-server": "^1.19.12",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "human-id": "^4.1.3",
    "postgres": "^3.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
