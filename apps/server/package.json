{
  "name": "@covel/server",
  "version": "0.0.47",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "drizzle.config.ts",
    "package.json",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "tsx watch --include \"../../plugins/**/*.md\" --include \"../../plugins/**/*.js\" --include \"../../plugins/**/*.json\" --include \"../../plugins/**/*.yaml\" --exclude \"../../plugins/**/node_modules\" --include \"../../packages/plugin-handlers-utils/src/**/*.ts\" --import=../../scripts/ensure-plugin-sdk.mjs --env-file-if-exists=../../.env --env-file-if-exists=../../.env.llm src/index.ts",
    "dev:pg": "node ../../scripts/run-with-env.mjs STORE_BACKEND=pg pnpm exec tsx watch --include \"../../plugins/**/*.md\" --include \"../../plugins/**/*.js\" --include \"../../plugins/**/*.json\" --include \"../../plugins/**/*.yaml\" --exclude \"../../plugins/**/node_modules\" --include \"../../packages/plugin-handlers-utils/src/**/*.ts\" --import=../../scripts/ensure-plugin-sdk.mjs --env-file-if-exists=../../.env --env-file-if-exists=../../.env.llm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "db:generate": "pnpm exec drizzle-kit generate --config=drizzle.config.ts",
    "db:studio": "pnpm exec drizzle-kit studio --config=drizzle.config.ts",
    "lint": "tsc --noEmit",
    "clean": "node ../../scripts/remove-paths.mjs dist"
  },
  "dependencies": {
    "@covel/ai-provider": "workspace:*",
    "@covel/approval": "workspace:*",
    "@covel/context": "workspace:*",
    "@covel/create": "workspace:*",
    "@covel/events": "workspace:*",
    "@covel/memory": "workspace:*",
    "@covel/plugin-loader": "workspace:*",
    "@covel/runtime": "workspace:*",
    "@covel/shared": "workspace:*",
    "@covel/store": "workspace:*",
    "@covel/tools": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@types/yauzl": "^3.4.0",
    "ajv": "^8.20.0",
    "hono": "4.13.8",
    "postgres": "^3.4.9",
    "tsx": "4.23.15",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yazl": "^3.3.1"
  }
}
