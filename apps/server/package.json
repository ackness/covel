{
  "name": "@covel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@covel/ai-provider": "workspace:*",
    "@covel/context": "workspace:*",
    "@covel/kernel": "workspace:*",
    "@covel/plugin-runtime": "workspace:*",
    "@covel/runtime": "workspace:*",
    "@covel/shared": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.12.0",
    "human-id": "^4.1.3",
    "postgres": "^3.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.1"
  }
}
