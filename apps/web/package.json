{
  "name": "@covel/web",
  "version": "0.0.54",
  "private": true,
  "deprecated": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate:routes && tsc -b && node ./scripts/build.mjs",
    "preview": "vite preview",
    "e2e:serve": "node ./scripts/e2e-serve.mjs",
    "build:e2e": "node ./scripts/e2e-serve.mjs --build-only",
    "generate:routes": "tsr generate",
    "lint": "tsc --noEmit && node ./scripts/check-tailwind-canonical.mjs",
    "lint:tailwind": "node ./scripts/check-tailwind-canonical.mjs",
    "check:i18n": "node --import tsx ./scripts/check-no-chinese-literal.mjs && node --import tsx --test ./scripts/locale-tools.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@covel/settings": "workspace:*",
    "@covel/shared": "workspace:*",
    "@covel/store": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@json-render/core": "^0.21.4",
    "@json-render/devtools-react": "0.21.4",
    "@json-render/directives": "0.21.4",
    "@json-render/react": "^0.21.4",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "i18next": "^26.7.1",
    "lucide-react": "1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-i18next": "17.1.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.16.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tailwind-lint": "^0.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
