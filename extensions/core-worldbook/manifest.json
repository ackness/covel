{
  "schemaVersion": "1.0",
  "name": "core-worldbook",
  "version": "0.1.0",
  "description": "Worldbook context package.",
  "scopes": ["world", "session"],
  "permissions": ["read:world", "read:session"],
  "modelPolicy": {
    "preferredTier": "small"
  },
  "contributes": {
    "context": [
      {
        "id": "worldbook-context",
        "entry": "server/context.ts",
        "reads": ["world", "session"],
        "writes": []
      }
    ],
    "commands": [
      {
        "name": "world-seeds",
        "description": "Inspect staged world seed content.",
        "argsSchema": "schemas/commands/world-seeds.args.json",
        "entry": "server/commands/world-seeds.ts",
        "resume": false
      }
    ],
    "blocks": [],
    "renderers": []
  }
}
