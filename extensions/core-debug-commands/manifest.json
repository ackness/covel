{
  "schemaVersion": "1.0",
  "name": "core-debug-commands",
  "version": "0.1.0",
  "description": "Debug command package.",
  "scopes": ["session"],
  "permissions": ["read:session", "read:trace", "read:packages"],
  "modelPolicy": {
    "preferredTier": "small"
  },
  "contributes": {
    "context": [],
    "commands": [
      {
        "name": "trace",
        "description": "Inspect the latest trace output.",
        "argsSchema": "schemas/commands/trace.args.json",
        "entry": "server/commands/trace.ts",
        "resume": false
      },
      {
        "name": "packages",
        "description": "Inspect enabled packages.",
        "argsSchema": "schemas/commands/packages.args.json",
        "entry": "server/commands/packages.ts",
        "resume": false
      },
      {
        "name": "session",
        "description": "Inspect the current session state.",
        "argsSchema": "schemas/commands/session.args.json",
        "entry": "server/commands/session.ts",
        "resume": false
      }
    ],
    "blocks": [],
    "renderers": []
  }
}
