                        }
                      },
                      "required": ["namespace"],
                      "additionalProperties": false
                    },
                    "description": "Committed plugin data records that must exist."
                  },
                  "assetGenerations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "modality": {
