{
  "$id": "https://covel.local/schemas/runtime-manifest.authoring.schema.json",
  "title": "Covel runtime manifest (strict authoring)",
  "description": "Strict target for newly authored plugins. Enforces every cross-field constraint, including a required stage on auto / scheduled runtimes.\n\nEnforced by Zod but not representable in this JSON Schema (validate with the Zod schema for these):\n- runtimeType 'function' requires a non-empty handler path.\n- output.schema is required when output.recordAs is set.\n- requireExplicitCompletion is only valid for non-story agent runtimes without output.schema.\n- trigger.topic is required when trigger.type is 'event'.\n- a runtime declaring `stage` cannot use trigger.type 'event' or 'manual'.\n- stage 'setup' runtimes must use trigger.type 'auto' with no interval/startTurn/cooldownTurns.\n- needs entries with scope 'session' are only valid on stage 'setup' runtimes.\n- turnCompletion.mode 'detached' is only valid on post-turn/audit staged runtimes.\n- turnCompletion.mode 'detached' cannot be used with outputKind 'story'.\n- event/manual runtimes use execution and cannot use detached turn completion.\n- turnCompletion queue/overlap/stale options require mode 'detached'.\n- effects.reads, effects.writes and permissions.http[].methods must contain unique entries.\n- an i18n description map must have at least one locale entry.\n- auto / scheduled runtimes must declare a stage.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*(?:\\/[a-z][a-z0-9-]*)*$"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "What the package does. Plain string or a locale map with at least one entry."
    },
    "displayName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ],
      "description": "Player-facing name. Plain string or a locale map."
    },
    "version": {
      "type": "string"
    },
    "runtimeType": {
      "type": "string",
      "enum": ["agent", "function"]
    },
    "handler": {
      "type": "string"
    },
    "guard": {
      "type": "string"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\/)(?!.*\\/\\.\\.\\/)(?!\\.\\.\\/)[a-zA-Z0-9_./-]+\\.[mMcC]?[jJ][sS]$",
      "description": "Package-relative path of the server entry module. It registers tools, actions, services, hooks and extensions."
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "point": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$",
            "description": "Extension point this entry provides.",
            "examples": ["prompt.segment@1"]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][\\w.-]*$",
            "description": "ID of this extension within the package."
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Sort order among providers of the same point. Lower values come first. Defaults to 0."
          },
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$",
            "description": "UI slot providers only: the kernel UI slot this entry fills."
          },
          "watch": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "UI slot providers only: own data namespaces whose changes refresh the slot."
          },
          "preview": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "UI slot providers only: event topics whose in-turn preview refreshes the slot."
          }
        },
        "required": ["point", "id"],
        "additionalProperties": false
      }
    },
    "model": {
      "type": "string"
    },
    "llm": {
      "type": "object",
      "properties": {
        "reasoningEffort": {
          "type": "string",
          "const": "disabled",
          "description": "`disabled` turns model reasoning off for this runtime."
        },
        "toolChoice": {
          "anyOf": [
            {
              "type": "string",
              "const": "required"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the tool to force."
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          ],
          "description": "`required` forces a tool call on every step. `{ name }` forces one named tool."
        }
      },
      "additionalProperties": false,
      "description": "Model call options for this runtime."
    },
    "history": {
      "type": "object",
      "properties": {
        "includeSummaries": {
          "description": "Include persisted summaries alongside the bounded history window. Defaults to false.",
          "type": "boolean"
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Number of most recent turns kept in the agent's prompt history. `0` sends no history."
        }
      },
      "required": ["maxTurns"],
      "additionalProperties": false,
      "description": "Bounds the agent's prompt history. When omitted, the runtime sees the shared session history."
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxSteps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "callTimeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "firstTokenTimeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idleTimeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "loopDetectionThreshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "requireToolUse": {
      "type": "boolean"
    },
    "requireExplicitCompletion": {
      "type": "boolean"
    },
    "completeAfterTools": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxRecursionDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "pluginType": {
      "type": "string",
      "enum": ["core-plugin", "plugin"]
    },
    "outputKind": {
      "type": "string",
      "enum": ["story", "plugin", "system"]
    },
    "concealed": {
      "type": "boolean"
    },
    "outputContract": {
      "type": "string",
      "minLength": 1
    },
    "defaultProvider": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)?$"
      }
    },
    "stage": {
      "type": "string",
      "enum": ["setup", "pre-turn", "narrative", "post-turn", "audit"]
    },
    "after": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["runtime"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cardinality": {
                    "type": "string",
                    "enum": ["one", "all"]
                  }
                },
                "required": ["capability"],
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "enum": ["turn", "session"]
              }
            },
            "required": ["runtime"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "cardinality": {
                "type": "string",
                "enum": ["one", "all"]
              },
              "scope": {
                "type": "string",
                "enum": ["turn", "session"]
              }
            },
            "required": ["capability"],
            "additionalProperties": false
          }
        ]
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["runtime"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cardinality": {
                    "type": "string",
                    "enum": ["one", "all"]
                  }
                },
                "required": ["capability"],
                "additionalProperties": false
              }
            ]
          },
          "select": {
            "type": "string",
            "pattern": "^(\\/([^/~]|~0|~1)*)*$"
          },
          "required": {
            "type": "boolean"
          },
          "accepts": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$"
              },
              {
                "type": "string",
                "pattern": "^contract:[a-z][a-z0-9.-]*@[1-9][0-9]*$"
              }
            ]
          }
        },
        "required": ["from"],
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "state:*",
                  "narrative:*",
                  "characters:*",
                  "assets:*",
                  "media:*",
                  "lorebook:*",
                  "ui:*",
                  "interaction:*",
                  "unknown:*"
                ]
              },
              {
                "type": "string",
                "pattern": "^plugin-data:self:[a-zA-Z_][a-zA-Z0-9_-]*$"
              },
              {
                "type": "string",
                "pattern": "^event:[^\\s]+$"
              },
              {
                "type": "string",
                "pattern": "^http:https:\\/\\/[^/?#@]+$"
              }
            ]
          },
          "description": "Resources the runtime reads, such as `narrative:*` or `plugin-data:self:<namespace>`. Entries must be unique."
        },
        "writes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "state:*",
                  "narrative:*",
                  "characters:*",
                  "assets:*",
                  "media:*",
                  "lorebook:*",
                  "ui:*",
                  "interaction:*",
                  "unknown:*"
                ]
              },
              {
                "type": "string",
                "pattern": "^plugin-data:self:[a-zA-Z_][a-zA-Z0-9_-]*$"
              },
              {
                "type": "string",
                "pattern": "^event:[^\\s]+$"
              },
              {
                "type": "string",
                "pattern": "^http:https:\\/\\/[^/?#@]+$"
              }
            ]
          },
          "description": "Resources the runtime writes, such as `state:*` or `event:<topic>`. Entries must be unique."
        },
        "parallelSafe": {
          "type": "boolean",
          "description": "`true` states that the runtime is safe to run in parallel with its stage siblings."
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "http": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "pattern": "^https:\\/\\/[^/?#@]+$",
                "description": "HTTPS origin the runtime may call, without path, query or credentials.",
                "examples": ["https://api.example.com"]
              },
              "methods": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]
                },
                "description": "HTTP methods allowed for the origin. Entries must be unique."
              }
            },
            "required": ["origin"],
            "additionalProperties": false
          },
          "description": "Upper bound of the HTTP origins and methods the runtime may use."
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "string",
      "enum": ["sync", "background"]
    },
    "turnCompletion": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["await", "detached"],
          "description": "`await` makes the turn wait for this runtime. `detached` lets the turn finish first; it is valid only on `post-turn` and `audit` stages. Defaults to `await`."
        },
        "settle": {
          "type": "string",
          "const": "before-next-execution",
          "description": "Makes the next player action wait until this detached runtime settles."
        },
        "maxSettleWaitMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "description": "Longest time in ms the next action waits for settlement. Requires `settle`."
        },
        "maxQueueMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Longest time in ms a detached job may wait in the queue."
        },
        "maxExecutionMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Longest time in ms a detached job may run."
        },
        "overlap": {
          "type": "string",
          "const": "serial",
          "description": "Overlap policy for detached jobs of this runtime. Only `serial` is supported."
        },
        "stalePolicy": {
          "type": "string",
          "const": "reject",
          "description": "Policy for a detached job that has become stale. Only `reject` is supported."
        }
      },
      "additionalProperties": false
    },
    "advertiseEvents": {
      "type": "boolean"
    },
    "tools": {
      "type": "object",
      "properties": {
        "builtin": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of builtin tools the runtime may call."
        },
        "plugin": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of this package's own tools the runtime may call. Each must be listed in `contributes.tools`. The runtime of a single-runtime package gets every contributed tool when this is omitted."
        },
        "defer": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Deferred tool loading. `true` defers the whole whitelist; a list defers only those names."
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "schema": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$"
            },
            {
              "type": "string",
              "pattern": "^contract:[a-z][a-z0-9.-]*@[1-9][0-9]*$"
            }
          ]
        },
        "inject": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "runtime"
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "as": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["kind", "from", "field", "as"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "plugin-data"
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "description": "Own data namespace to inline. Data of other plugins cannot be read."
                  },
                  "as": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Tag that wraps the injected block in the prompt.",
                    "examples": ["<existing-affinity>"]
                  },
                  "format": {
                    "default": "summary",
                    "description": "`summary` lists key, update time and truncated JSON. `ids-only` lists keys. `full` lists complete JSON. Defaults to `summary`.",
                    "type": "string",
                    "enum": ["summary", "full", "ids-only"]
                  },
                  "maxEntries": {
                    "default": 50,
                    "description": "Maximum number of entries injected. Above it, half are the oldest and half the most recently updated. Defaults to 50.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500
                  }
                },
                "required": ["kind", "namespace", "as"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "runtime-export"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  },
                  "from": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "runtime": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["runtime"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "capability": {
                            "type": "string",
                            "minLength": 1
                          },
                          "cardinality": {
                            "type": "string",
                            "enum": ["one", "all"]
                          }
                        },
                        "required": ["capability"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "recordAs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accepts": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$"
                      },
                      {
                        "type": "string",
                        "pattern": "^contract:[a-z][a-z0-9.-]*@[1-9][0-9]*$"
                      }
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": ["kind", "name", "from", "recordAs"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "kernel"
                  },
                  "from": {
                    "type": "string",
                    "const": "turn-digest@1"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "required": ["kind", "from", "name"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "recordAs": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dataSchemas": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "schemaVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "acceptsWorldData": {
            "type": "boolean"
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$",
            "description": "Package-relative path of the JSON Schema that validates each record."
          },
          "description": {
            "type": "string",
            "description": "What the namespace stores. Read by world authors and tools."
          }
        },
        "required": ["schemaVersion", "acceptsWorldData", "schema"],
        "additionalProperties": false
      }
    },
    "worldProjections": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Schema URI of the world data source to project. Only sources with exactly this schema are projected."
          },
          "handler": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*\\/\\.\\.\\/)(?!\\.\\.\\/)[a-zA-Z0-9_./-]+\\.[mMcC]?[jJ][sS]$",
            "description": "Package-relative path of the pure projection handler module."
          },
          "outputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
                  "description": "Own data namespace that receives the projected records."
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
                  "description": "Field of each projected record used as its stable key."
                }
              },
              "required": ["namespace", "key"],
              "additionalProperties": false
            },
            "description": "Destinations keyed by output ID. At least one is required.",
            "minProperties": 1
          }
        },
        "required": ["from", "handler", "outputs"],
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
            "description": "Event topic in dot-separated kebab-case.",
            "examples": ["scene.set"]
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$",
            "description": "Package-relative path of the JSON Schema that validates the event payload."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ],
            "description": "What the event means. Given to runtimes that may emit it."
          },
          "advertise": {
            "default": true,
            "description": "`true` advertises the event to runtimes that emit events. Defaults to `true`.",
            "type": "boolean"
          }
        },
        "required": ["topic", "schema", "description"],
        "additionalProperties": false
      },
      "description": "Domain events the package's runtimes may emit with the builtin `emit-event` tool."
    },
    "i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "right": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths of UI specs for right-panel tabs."
        },
        "message": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths of UI specs rendered inside the message stream."
        },
        "left": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths of UI specs for the left panel."
        }
      },
      "additionalProperties": false,
      "description": "Package-relative paths of declarative UI specs, by placement."
    },
    "userSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
            "description": "Setting key. Runtimes read it from `ctx.userSettings`."
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "integer",
              "toggle",
              "select",
              "slider",
              "slot"
            ],
            "description": "Control type. `select` needs `options`; `slot` lets the player pick a model slot."
          },
          "default": {
            "description": "Value used when neither the player nor the world sets one."
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ],
            "description": "Label shown in the settings panel."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ],
            "description": "Help text shown with the control."
          },
          "min": {
            "type": "number",
            "description": "Minimum for numeric controls."
          },
          "max": {
            "type": "number",
            "description": "Maximum for numeric controls."
          },
          "step": {
            "type": "number",
            "description": "Step for numeric controls."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "description": "Stored value of the option."
                },
                "label": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ],
                  "description": "Label shown for the option."
                }
              },
              "required": ["value", "label"]
            },
            "description": "Choices of a `select` control."
          }
        },
        "required": ["key", "type", "label"],
        "additionalProperties": false
      },
      "description": "Player-configurable settings. A world can preset them with `pluginSettings`."
    },
    "commands": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Command name in lowercase kebab-case, without the leading slash."
          },
          "aliases": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "description": "Other names that invoke the same command."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ],
            "description": "What the command does. Shown to the player."
          },
          "arguments": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "Argument name in lowercase kebab-case."
                },
                "type": {
                  "type": "string",
                  "enum": ["string", "integer", "number", "boolean"],
                  "description": "Value type of the argument. Defaults to string."
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ],
                  "description": "What the argument means. Shown to the player."
                },
                "required": {
                  "type": "boolean",
                  "description": "`true` when the player must supply the argument."
                },
                "variadic": {
                  "type": "boolean",
                  "description": "`true` collects all remaining words. Only the last argument can be variadic."
                },
                "choices": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Allowed values of the argument."
                }
              },
              "required": ["name"],
              "additionalProperties": false
            },
            "description": "Positional arguments, in order. Names must be unique."
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "RPC action the command invokes. It must be listed in `contributes.actions`."
          },
          "context": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["session", "active-runtimes", "models"]
            },
            "description": "Host context scopes passed to the action."
          }
        },
        "required": ["name", "description", "action"],
        "additionalProperties": false
      },
      "description": "Player slash commands. Each `action` must be listed in `actions`."
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["auto", "manual", "scheduled", "event"],
          "description": "`auto` runs every turn in its stage. `scheduled` runs every `interval` turns. `manual` runs on an explicit RPC call. `event` runs when `topic` is emitted."
        },
        "interval": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Interval in turns. For `scheduled` only."
        },
        "topic": {
          "type": "string",
          "description": "Event topic to subscribe to. Required for `event`."
        },
        "maxTriggerCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum number of triggers in one session."
        },
        "cooldownTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Minimum number of turns between two triggers."
        },
        "startTurn": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "First logical turn at which the runtime may trigger. When unset, it triggers as soon as its stage opens."
        }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  },
  "required": ["name", "description"],
  "additionalProperties": false
}
