{
  "$id": "https://covel.local/schemas/runtime-manifest.compiled.schema.json",
  "title": "Covel compiled runtime manifest (internal, not an authoring format)",
  "description": "The internal RuntimeManifest the plugin loader compiles each RUNTIME.md or inline runtime into. Authors write runtime-manifest.schema.json instead; this file documents the compiled form for host and tool code.\n\nEnforced by Zod but not representable in this JSON Schema (validate with the Zod schema for these):\n- runtimeType 'function' requires a non-empty handler path.\n- output.schema is required when output.recordAs is set.\n- requireExplicitCompletion is only valid for non-story agent runtimes without output.schema.\n- loopProfile.preset 'story' requires outputKind 'story'.\n- a resolved loopProfile.stream or loopProfile.steering of true requires outputKind 'story'.\n- loopProfile.truncation 'accept' requires a resolved loopProfile.stream of true.\n- loopProfile.finalizer.deadlineReserveMs must be smaller than timeoutMs.\n- trigger.topic is required when trigger.type is 'event'.\n- a runtime declaring `stage` cannot use trigger.type 'event' or 'manual'.\n- stage 'setup' runtimes must use trigger.type 'auto' with no every/startTurn/cooldownTurns.\n- every is only valid on an 'auto' runtime.\n- needs entries with scope 'session' are only valid on stage 'setup' runtimes.\n- turnCompletion.mode 'detached' is only valid on post-turn/audit staged runtimes.\n- turnCompletion.mode 'detached' cannot be used with outputKind 'story'.\n- event/manual runtimes use execution and cannot use detached turn completion.\n- a subagentOnly runtime is an agent runtime with an implied 'manual' trigger and no stage, needs, after, background execution, output.recordAs, guard or outputKind 'story'.\n- turnCompletion settle/wait/queue/execution options require mode 'detached', and maxSettleWaitMs requires settle.\n- effects.reads, effects.writes and permissions.http[].methods must contain unique entries.\n- an i18n description map must have at least one locale entry.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*(?:\\/[a-z][a-z0-9-]*)*$"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "What the package does. Plain string; translations go in locale files."
    },
    "version": {
      "type": "string"
    },
    "runtimeType": {
      "type": "string",
      "enum": ["agent", "function"]
    },
    "handler": {
      "type": "string"
    },
    "guard": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "llm": {
      "type": "object",
      "properties": {
        "reasoningEffort": {
          "type": "string",
          "const": "disabled",
          "description": "`disabled` turns model reasoning off for this runtime."
        },
        "toolChoice": {
          "anyOf": [
            {
              "type": "string",
              "const": "required"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the tool to force."
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          ],
          "description": "`required` forces a tool call on every step. `{ name }` forces one named tool."
        }
      },
      "additionalProperties": false,
      "description": "Model call options for this runtime."
    },
    "history": {
      "type": "object",
      "properties": {
        "includeSummaries": {
          "description": "Include persisted summaries alongside the bounded history window. Defaults to false.",
          "type": "boolean"
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Number of most recent turns kept in the agent's prompt history. `0` sends no history."
        }
      },
      "required": ["maxTurns"],
      "additionalProperties": false,
      "description": "Bounds the agent's prompt history. When omitted, the runtime sees the shared session history."
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxSteps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "callTimeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "firstTokenTimeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idleTimeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "loopDetectionThreshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "requireToolUse": {
      "type": "boolean"
    },
    "requireExplicitCompletion": {
      "type": "boolean"
    },
    "completeAfterTools": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "loopProfile": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["story", "actor", "system"]
        },
        "stream": {
          "type": "boolean"
        },
        "steering": {
          "type": "boolean"
        },
        "truncation": {
          "type": "string",
          "enum": ["accept", "reject"]
        },
        "fallback": {
          "type": "string",
          "enum": ["answer-without-tools", "fail"]
        },
        "corrections": {
          "type": "object",
          "properties": {
            "toolUse": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "review": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "loopPerturbation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "outputRepair": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "additionalProperties": false
        },
        "finalizer": {
          "type": "object",
          "properties": {
            "maxSteps": {
              "type": "boolean"
            },
            "deadlineReserveMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "maxRecursionDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "outputKind": {
      "type": "string",
      "enum": ["story", "system"]
    },
    "concealed": {
      "type": "boolean"
    },
    "outputContract": {
      "type": "string",
      "minLength": 1
    },
    "defaultProvider": {
      "type": "boolean"
    },
    "subagentOnly": {
      "type": "boolean",
      "const": true
    },
    "stage": {
      "type": "string",
      "enum": ["setup", "pre-turn", "narrative", "post-turn", "audit"]
    },
    "after": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["runtime"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cardinality": {
                    "type": "string",
                    "enum": ["one", "all"]
                  }
                },
                "required": ["capability"],
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "enum": ["turn", "session"]
              }
            },
            "required": ["runtime"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "cardinality": {
                "type": "string",
                "enum": ["one", "all"]
              },
              "scope": {
                "type": "string",
                "enum": ["turn", "session"]
              }
            },
            "required": ["capability"],
            "additionalProperties": false
          }
        ]
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["runtime"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cardinality": {
                    "type": "string",
                    "enum": ["one", "all"]
                  }
                },
                "required": ["capability"],
                "additionalProperties": false
              }
            ]
          },
          "select": {
            "type": "string",
            "pattern": "^(\\/([^/~]|~0|~1)*)*$"
          },
          "required": {
            "type": "boolean"
          },
          "accepts": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$"
              },
              {
                "type": "string",
                "pattern": "^contract:[a-z][a-z0-9.-]*@[1-9][0-9]*$"
              }
            ]
          }
        },
        "required": ["from"],
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "state:*",
                  "narrative:*",
                  "characters:*",
                  "assets:*",
                  "media:*",
                  "lorebook:*",
                  "ui:*",
                  "interaction:*",
                  "unknown:*"
                ]
              },
              {
                "type": "string",
                "pattern": "^plugin-data:self:[a-zA-Z_][a-zA-Z0-9_-]*$"
              },
              {
                "type": "string",
                "pattern": "^event:[^\\s]+$"
              },
              {
                "type": "string",
                "pattern": "^http:https:\\/\\/[^/?#@]+$"
              }
            ]
          },
          "description": "Resources the runtime reads, such as `narrative:*` or `plugin-data:self:<namespace>`. Entries must be unique."
        },
        "writes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "state:*",
                  "narrative:*",
                  "characters:*",
                  "assets:*",
                  "media:*",
                  "lorebook:*",
                  "ui:*",
                  "interaction:*",
                  "unknown:*"
                ]
              },
              {
                "type": "string",
                "pattern": "^plugin-data:self:[a-zA-Z_][a-zA-Z0-9_-]*$"
              },
              {
                "type": "string",
                "pattern": "^event:[^\\s]+$"
              },
              {
                "type": "string",
                "pattern": "^http:https:\\/\\/[^/?#@]+$"
              }
            ]
          },
          "description": "Resources the runtime writes, such as `state:*` or `event:<topic>`. Entries must be unique."
        },
        "parallelSafe": {
          "type": "boolean",
          "description": "`true` states that the runtime is safe to run in parallel with its stage siblings."
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "http": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "pattern": "^https:\\/\\/[^/?#@]+$",
                "description": "HTTPS origin the runtime may call, without path, query or credentials.",
                "examples": ["https://api.example.com"]
              },
              "methods": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]
                },
                "description": "HTTP methods allowed for the origin. Entries must be unique."
              }
            },
            "required": ["origin"],
            "additionalProperties": false
          },
          "description": "Upper bound of the HTTP origins and methods the runtime may use."
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "string",
      "enum": ["sync", "background"]
    },
    "turnCompletion": {
      "type": "object",
      "properties": {
        "settle": {
          "type": "boolean",
          "description": "`true` makes the next player action wait until this runtime's job has finished, for at most `maxSettleWaitMs`. Defaults to `false`."
        },
        "maxSettleWaitMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "description": "Longest time in ms the next action waits for the job, at most 120000. Requires `settle: true`."
        },
        "maxQueueMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Longest time in ms the job may wait in the queue."
        },
        "maxExecutionMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Longest time in ms the job may run."
        },
        "mode": {
          "type": "string",
          "enum": ["await", "detached"],
          "description": "`await` makes the turn wait for this runtime. `detached` lets the turn finish first. Defaults to `await`."
        }
      },
      "additionalProperties": false
    },
    "advertiseEvents": {
      "type": "boolean"
    },
    "tools": {
      "type": "object",
      "properties": {
        "builtin": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of builtin tools the runtime may call."
        },
        "plugin": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of this package's own tools the runtime may call. Each must be listed in `contributes.tools`. The runtime of a single-runtime package gets every contributed tool when this is omitted."
        },
        "defer": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Deferred tool loading. `true` defers the whole whitelist; a list defers only those names."
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              }
            },
            "required": ["contract", "name"],
            "additionalProperties": false
          }
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dataset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["get", "list", "upsert", "update"]
                }
              }
            },
            "required": ["dataset", "tools"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "schema": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$"
            },
            {
              "type": "string",
              "pattern": "^contract:[a-z][a-z0-9.-]*@[1-9][0-9]*$"
            }
          ]
        },
        "inject": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "plugin-data"
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "description": "Own data namespace to inline. Data of other plugins cannot be read."
                  },
                  "as": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Tag that wraps the injected block in the prompt.",
                    "examples": ["<existing-affinity>"]
                  },
                  "format": {
                    "default": "summary",
                    "description": "`summary` lists key, update time and truncated JSON. `ids-only` lists keys. `full` lists complete JSON. Defaults to `summary`.",
                    "type": "string",
                    "enum": ["summary", "full", "ids-only"]
                  },
                  "maxEntries": {
                    "default": 50,
                    "description": "Maximum number of entries injected. Above it, half are the oldest and half the most recently updated. Defaults to 50.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500
                  }
                },
                "required": ["kind", "namespace", "as"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "runtime-export"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  },
                  "from": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "runtime": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["runtime"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "capability": {
                            "type": "string",
                            "minLength": 1
                          },
                          "cardinality": {
                            "type": "string",
                            "enum": ["one", "all"]
                          }
                        },
                        "required": ["capability"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "recordAs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accepts": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$"
                      },
                      {
                        "type": "string",
                        "pattern": "^contract:[a-z][a-z0-9.-]*@[1-9][0-9]*$"
                      }
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": ["kind", "name", "from", "recordAs"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "kernel"
                  },
                  "from": {
                    "type": "string",
                    "enum": ["turn-digest@1", "operations@1"]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "required": ["kind", "from", "name"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "recordAs": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["auto", "manual", "event"],
          "description": "`auto` runs in its stage every turn, or every `every`-th turn. `manual` runs on an explicit RPC call. `event` runs when `topic` is emitted."
        },
        "every": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "`auto` only: run on the logical turns that are a multiple of this number. Defaults to 1, every turn."
        },
        "topic": {
          "type": "string",
          "description": "Event topic to subscribe to. Required for `event`."
        },
        "maxTriggerCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum number of triggers in one session."
        },
        "cooldownTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Minimum number of turns between two triggers."
        },
        "startTurn": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "First logical turn at which the runtime may trigger. When unset, it triggers as soon as its stage opens."
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "dataSchemas": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "schemaVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "acceptsWorldData": {
            "type": "boolean"
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$",
            "description": "Package-relative path of the JSON Schema that validates each record."
          },
          "description": {
            "type": "string",
            "description": "What the namespace stores. Read by world authors and tools."
          }
        },
        "required": ["schemaVersion", "acceptsWorldData", "schema"],
        "additionalProperties": false
      }
    },
    "datasets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
            "description": "Plugin-data namespace; equals the dataset name."
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9_./-]+\\.json$",
            "description": "Package-relative JSON Schema that every record of the dataset must satisfy."
          },
          "key": {
            "type": "string",
            "description": "Top-level record field whose string value is the record's key."
          },
          "ops": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "set",
                "merge",
                "inc",
                "append",
                "insert",
                "remove",
                "upsertItem",
                "delete"
              ]
            },
            "description": "Operation kinds allowed on this dataset. Defaults to every kind."
          },
          "tools": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["get", "list", "upsert", "update"]
            },
            "description": "Dataset tools an agent may select."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "What the dataset holds, in English. Agents read it in the description of each dataset tool."
          }
        },
        "required": ["namespace", "schema", "ops", "tools"],
        "additionalProperties": false
      }
    },
    "userSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
            "description": "Setting key. Runtimes read it from `ctx.userSettings`."
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "integer",
              "toggle",
              "select",
              "slider",
              "slot"
            ],
            "description": "Control type. `select` needs `options`; `slot` lets the player pick a model slot."
          },
          "default": {
            "description": "Value used when neither the player nor the world sets one."
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ],
            "description": "Label shown in the settings panel."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ],
            "description": "Help text shown with the control."
          },
          "min": {
            "type": "number",
            "description": "Minimum for numeric controls."
          },
          "max": {
            "type": "number",
            "description": "Maximum for numeric controls."
          },
          "step": {
            "type": "number",
            "description": "Step for numeric controls."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "description": "Stored value of the option."
                },
                "label": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ],
                  "description": "Label shown for the option."
                }
              },
              "required": ["value", "label"]
            },
            "description": "Choices of a `select` control."
          }
        },
        "required": ["key", "type", "label"],
        "additionalProperties": false
      },
      "description": "Player-configurable settings. A world can preset them with `pluginSettings`."
    }
  },
  "required": ["name", "description"],
  "additionalProperties": false
}
