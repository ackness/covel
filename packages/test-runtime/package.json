{
  "name": "@covel/test-runtime",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "bin": {
    "covel-test-runtime": "./src/cli.ts",
    "test-runtime": "./src/cli.ts",
    "test_runtime": "./src/cli.ts"
  },
