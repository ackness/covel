{
  "name": "@covel/store",
  "version": "0.0.52",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./browser-sync": {
      "types": "./src/browser-sync/index.ts",
      "import": "./src/browser-sync/index.ts"
    },
    "./idb-schema": {
      "types": "./src/indexeddb/idb-schema.ts",
      "import": "./src/indexeddb/idb-schema.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts"
    },
    "./vector": {
      "types": "./src/vector-store.ts",
      "import": "./src/vector-store.ts"
    },
    "./factory": {
      "types": "./src/factory.ts",
      "import": "./src/factory.ts"
    },
    "./memory": {
      "types": "./src/memory-entry.ts",
      "import": "./src/memory-entry.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite-entry.ts",
      "import": "./src/sqlite-entry.ts"
    },
    "./postgres": {
      "types": "./src/postgres-entry.ts",
      "import": "./src/postgres-entry.ts"
    },
    "./session": {
      "types": "./src/session-entry.ts",
      "import": "./src/session-entry.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts"
    },
    "./capabilities": {
      "types": "./src/storage-capabilities.ts",
      "import": "./src/storage-capabilities.ts"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-ddl": "tsx scripts/print-ddl.ts",
    "clean": "node ../../scripts/remove-paths.mjs dist"
  },
  "dependencies": {
    "@covel/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
