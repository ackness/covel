{
  "name": "@covel/store",
  "version": "0.0.23",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./idb": {
      "types": "./src/indexeddb/idb-store.ts",
      "import": "./src/indexeddb/idb-store.ts"
    },
    "./idb-schema": {
      "types": "./src/indexeddb/idb-schema.ts",
      "import": "./src/indexeddb/idb-schema.ts"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-ddl": "tsx scripts/print-ddl.ts",
    "clean": "node ../../scripts/remove-paths.mjs dist"
  },
  "dependencies": {
    "@covel/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "postgres": "^3.4.9",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
