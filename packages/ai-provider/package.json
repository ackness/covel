{
  "name": "@covel/ai-provider",
  "version": "0.0.52",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config/llm-loader.ts",
      "import": "./src/config/llm-loader.ts"
    },
    "./image-wires": {
      "types": "./src/image/wire-registry.ts",
      "import": "./src/image/wire-registry.ts"
    },
    "./url-safety": {
      "types": "./src/adapters/http/url-safety.ts",
      "import": "./src/adapters/http/url-safety.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "node ../../scripts/remove-paths.mjs dist",
    "update-model-db": "tsx scripts/update-model-db.ts && vitest run tests/reasoning-characterization.test.ts -u"
  },
  "dependencies": {
    "@covel/shared": "workspace:*",
    "smol-toml": "^1.9.1",
    "undici": "8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
