{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "error"]
    },
    "imageUrl": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    }
  },
  "required": ["messageId", "status", "imageUrl", "caption"]
}
