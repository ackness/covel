{
  "id": "prompt-optimizer",
  "displayName": {
    "zh-CN": "插画提示词优化器",
    "en-US": "Image Prompt Optimizer"
  },
  "priority": 710,
  "trigger": {
    "type": "manual",
    "action": "generate-story-image"
  },
  "limits": {
    "maxRunsPerSession": null,
    "maxRunsPerTurn": 1
  },
  "instructionsRef": "instructions.md",
  "outputSchemaRef": "output.schema.json",
  "llmConfigRef": "llm.toml",
  "settings": [
    {
      "key": "style",
      "type": "enum",
      "label": {
        "zh-CN": "画风",
        "en-US": "Style"
      },
      "default": "cinematic",
      "options": [
        {
          "value": "cinematic",
          "label": {
            "zh-CN": "电影感",
            "en-US": "Cinematic"
          }
        },
        {
          "value": "anime",
          "label": {
            "zh-CN": "动漫",
            "en-US": "Anime"
          }
        },
        {
          "value": "watercolor",
          "label": {
            "zh-CN": "水彩",
            "en-US": "Watercolor"
          }
        }
      ]
    }
  ],
  "systemTools": [
    "kernel:query_records",
    "kernel:query_tables",
    "kernel:load_reference"
  ],
  "toolImports": [],
  "tableAccess": {
    "read": [
      "core-states.character",
      "core-states.world",
      "image-workflow-demo.*"
    ],
    "writeOwnedOnly": true
  }
}
