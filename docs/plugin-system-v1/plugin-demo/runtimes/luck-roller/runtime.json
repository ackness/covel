{
  "id": "luck-roller",
  "displayName": {
    "zh-CN": "幸运事件判定器",
    "en-US": "Luck Event Resolver"
  },
  "priority": 620,
  "trigger": {
    "type": "turn"
  },
  "limits": {
    "maxRunsPerSession": null,
    "maxRunsPerTurn": 1
  },
  "instructionsRef": "instructions.md",
  "outputSchemaRef": "output.schema.json",
  "llmConfigRef": "llm.toml",
  "settings": [
    {
      "key": "enabled",
      "type": "boolean",
      "label": {
        "zh-CN": "每轮自动判定",
        "en-US": "Evaluate every turn"
      },
      "default": true
    },
    {
      "key": "triggerChance",
      "type": "number",
      "label": {
        "zh-CN": "触发概率",
        "en-US": "Trigger Chance"
      },
      "description": {
        "zh-CN": "建议在 0.1 到 0.8 之间，用于控制这类幸运事件出现的频率。",
        "en-US": "Recommended range: 0.1 to 0.8. Controls how often luck events appear."
      },
      "default": 0.35
    },
    {
      "key": "luckWeight",
      "type": "number",
      "label": {
        "zh-CN": "幸运权重",
        "en-US": "Luck Weight"
      },
      "default": 1.0
    }
  ],
  "systemTools": [
    "kernel:query_tables",
    "kernel:write_table",
    "kernel:emit_domain_event",
    "kernel:exec_script",
    "kernel:load_reference"
  ],
  "toolImports": [],
  "tableAccess": {
    "read": [
      "core-states.character",
      "demo-plugin.*"
    ],
    "writeOwnedOnly": true
  }
}
