{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["none", "common", "rare", "epic"]
    },
    "roll": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100
    },
    "modifier": {
      "type": ["integer", "null"]
    },
    "eventId": {
      "type": ["string", "null"]
    },
    "eventTitle": {
      "type": ["string", "null"]
    },
    "eventEffect": {
      "type": ["string", "null"]
    },
    "eventTag": {
      "type": ["string", "null"]
    },
    "tableKey": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "applied",
    "reason",
    "tier",
    "roll",
    "modifier",
    "eventId",
    "eventTitle",
    "eventEffect",
    "eventTag",
    "tableKey"
  ]
}
