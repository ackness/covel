{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:covel:schema:runtime-trigger-event:v0alpha1",
  "title": "Covel Runtime Trigger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "sourceKind", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "sourceKind": {
      "type": "string",
      "enum": ["user", "system", "runtime", "tool", "hook", "commit"]
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
