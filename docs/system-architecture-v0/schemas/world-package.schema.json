{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:covel:schema:world-package:v0alpha1",
  "title": "Covel World Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "summary",
    "defaultLocale",
    "supportedLocales",
    "characterSchema",
    "contentVariants"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "covel.world-package/v0alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "$ref": "#/$defs/i18nText"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "summary": {
      "$ref": "#/$defs/i18nText"
    },
    "defaultLocale": {
      "description": "Package-level default locale. Defaults to zh-CN but world authors may choose another locale.",
      "type": "string",
      "minLength": 1,
      "default": "zh-CN"
    },
    "supportedLocales": {
      "description": "Package-level locale support for metadata selection and runtime locale negotiation. Actual markdown coverage is determined by contentVariants.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "uniqueItems": true,
      "default": ["zh-CN", "en-US"],
      "allOf": [
        {
          "contains": {
            "const": "zh-CN"
          }
        },
        {
          "contains": {
            "const": "en-US"
          }
        }
      ]
    },
    "characterSchema": {
      "description": "Character field contract. Can be a relative file path to a JSON Schema (string) or an inline JSON Schema object.",
      "type": ["string", "object"],
      "minLength": 1,
      "minProperties": 1
    },
    "requiredPlugins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "recommendedPlugins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "contentVariants": {
      "description": "Actual markdown content variants provided by the author. At least one variant must exist whose locale matches the package defaultLocale; other locale variants are optional.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "path"],
        "properties": {
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "$ref": "#/$defs/i18nText"
          }
        }
      }
    }
  },
  "$defs": {
    "i18nText": {
      "type": ["string", "object"],
      "minLength": 1,
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
