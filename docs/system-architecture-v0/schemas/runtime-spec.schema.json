{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:covel:schema:runtime-spec:v0alpha1",
  "title": "Covel Public Runtime Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pluginId", "kind", "phase", "trigger", "tools", "hooks"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": ["story", "plugin", "background", "verifier"]
    },
    "phase": {
      "type": "string",
      "enum": ["pre_story", "story", "post_story", "background"]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["always", "interval", "manual", "event"],
          "default": "always"
        },
        "onEvents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "intervalTurns": {
          "type": "integer",
          "minimum": 1
        },
        "modeSettingKey": {
          "type": "string",
          "minLength": 1
        },
        "intervalSettingKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "providerBinding": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "instructionsRef": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["proposal", "text", "json", "none"],
          "default": "proposal"
        }
      }
    },
    "failurePolicy": {
      "type": "string",
      "enum": ["continue", "stop", "retry", "disable_runtime"],
      "default": "continue"
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readScopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "writeScopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "allowScripts": {
          "type": "boolean",
          "default": false
        },
        "allowMcp": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
