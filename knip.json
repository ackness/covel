{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["only-allow", "ps", "which", "actionlint"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "better-sqlite3",
        "sqlite-vec",
        "@types/better-sqlite3"
      ]
    },
    "apps/desktop": {
      "ignoreDependencies": ["tsx"]
    },
    "plugins/*": {
      "entry": [
        "handler.js",
        "guard.js",
        "server/index.js",
        "hooks/*.js",
        "tools/*.js",
        "runtimes/*/handler.js",
        "runtimes/*/guard.js"
      ]
    }
  }
}
