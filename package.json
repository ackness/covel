{
  "name": "covel",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start:runtime": "tsx apps/runtime/src/main.ts",
    "test": "vitest run --exclude modules/model-gateway/tests/live.openai-compatible.test.ts",
    "test:watch": "vitest --exclude modules/model-gateway/tests/live.openai-compatible.test.ts",
    "test:contracts": "vitest run modules/contracts/tests",
    "test:domain": "vitest run modules/domain/tests",
    "test:live": "vitest run modules/model-gateway/tests/live.openai-compatible.test.ts",
    "test:web": "vitest run apps/web/tests/*.test.ts apps/web/tests/*.test.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.5.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.0.1",
    "pg-mem": "3.0.14",
    "tsx": "4.21.0",
    "turbo": "2.8.20",
    "typescript": "6.0.2",
    "vite": "8.0.2",
    "vitest": "4.1.1",
    "zod": "4.3.6"
  }
}
