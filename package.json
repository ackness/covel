{
  "name": "covel",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "node ./scripts/dev-supervisor.mjs pnpm --filter @covel/web dev",
    "dev:server": "node ./scripts/dev-supervisor.mjs pnpm --filter @covel/server dev",
    "dev:pg:preflight": "node ./scripts/dev-pg-preflight.mjs",
    "dev:pg": "pnpm run dev:pg:preflight && node ./scripts/dev-supervisor.mjs pnpm --filter @covel/server dev:pg",
    "stop": "node ./scripts/stop-dev.mjs",
    "build": "turbo build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "lint:ci": "node ./scripts/lint-ci.mjs",
    "deps:check": "knip --dependencies",
    "clean": "turbo clean",
    "clean:desktop": "pnpm --filter @covel/desktop clean",
    "db:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d postgres",
    "db:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "docker:build": "docker compose -f docker/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:down-all": "docker compose -f docker/docker-compose.yml --env-file .env down -v",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file .env logs -f",
    "db:migrate": "turbo db:migrate --filter=@covel/server",
    "db:generate": "turbo db:generate --filter=@covel/server",
    "db:studio": "turbo db:studio --filter=@covel/server",
    "check:i18n": "pnpm --filter @covel/web check:i18n && pnpm run check:plugins",
    "check:i18n:plugins": "node ./scripts/check-plugin-i18n.mjs",
    "check:plugins": "node ./scripts/check-plugin-i18n.mjs && node ./scripts/check-plugin-readmes.mjs",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dev:electron": "pnpm --filter @covel/desktop dev",
    "build:electron": "pnpm --filter @covel/desktop dist && node apps/desktop/scripts/cleanup-artifacts.mjs --strip-unpacked",
    "build:desktop": "pnpm run build:electron",
    "e2e:verify": "tsx --env-file=.env --env-file=.env.llm scripts/e2e-plugin-verify.ts",
    "test:runtime": "tsx packages/test-runtime/src/cli.ts",
    "create-plugin": "node scripts/create-plugin.js",
    "release:preflight": "node ./scripts/release-preflight.mjs",
    "preinstall": "npx only-allow@1.2.2 pnpm"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "better-sqlite3": "^12.11.1",
    "cross-spawn": "^7.0.6",
    "knip": "^6.17.1",
    "playwright": "^1.61.0",
    "prettier": "^3.8.4",
    "sqlite-vec": "^0.1.9",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "yaml": "^2.9.0"
  }
}
