{
  "name": "covel",
  "version": "0.0.49",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "node ./scripts/dev-supervisor.mjs pnpm --filter @covel/web dev",
    "dev:server": "node ./scripts/dev-supervisor.mjs pnpm --filter @covel/server dev",
    "dev:pg": "node --env-file-if-exists=.env ./scripts/dev-pg-preflight.mjs && node ./scripts/dev-supervisor.mjs pnpm --filter @covel/server dev:pg",
    "stop": "node ./scripts/stop-dev.mjs",
    "build": "turbo build",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "check": "pnpm peers check && pnpm lint && pnpm check:oxlint && pnpm check:boundaries && pnpm deps:check && pnpm check:manifests && pnpm check:schemas && pnpm check:prompts && pnpm check:i18n && pnpm check:scripts && pnpm check:workflows",
    "check:oxlint": "oxlint --deny-warnings",
    "check:manifests": "node scripts/check-plugin-manifests.mjs",
    "check:schemas": "node scripts/generate-schema-reference.mjs --check",
    "check:prompts": "node scripts/check-prompt-variants.mjs",
    "prompts:lock": "node scripts/check-prompt-variants.mjs --write",
    "check:scripts": "node --test scripts/tests/*.test.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:push": "node scripts/check-push.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "deps:check": "fallow dead-code --unused-deps --unlisted-deps --unresolved-imports",
    "analyze": "fallow --score",
    "clean": "turbo clean",
    "db:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d postgres",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "docker:build": "docker compose -f docker/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:down-all": "docker compose -f docker/docker-compose.yml --env-file .env down -v",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file .env logs -f",
    "db:generate": "pnpm --filter @covel/server db:generate",
    "db:studio": "pnpm --filter @covel/server db:studio",
    "i18n:add": "node --import tsx ./apps/web/scripts/add-locale.mjs",
    "check:i18n": "pnpm --filter @covel/web check:i18n && pnpm run check:plugins",
    "check:plugins": "node --import tsx ./scripts/check-plugin-i18n.mjs && node ./scripts/check-plugin-readmes.mjs",
    "test": "turbo test",
    "test:docs": "pnpm --filter @covel/plugin-loader exec vitest run tests/authoring-guide-examples.test.ts && pnpm --filter @covel/server exec vitest run tests/lib/authoring-describe.test.ts && pnpm --filter @covel/runtime exec vitest run tests/hooks-reference-doc.test.ts",
    "test:pg": "node --env-file-if-exists=.env scripts/test-postgres.mjs",
    "test:plugin-lifecycle": "pnpm --filter @covel/server exec vitest run tests/api/third-party-plugin-lifecycle.test.ts tests/api/third-party-runtime-contracts.test.ts",
    "test:tabletop-plugin": "pnpm --filter @covel/server exec vitest run tests/api/third-party-tabletop.test.ts",
    "pack:tabletop-plugin": "pnpm --filter @covel/server exec tsx tests/helpers/tabletop-package.ts",
    "pack:test-plugin": "pnpm --filter @covel/server exec tsx tests/helpers/third-party-package.ts",
    "test:coverage": "pnpm test:coverage:vitest && pnpm test:coverage:desktop",
    "test:coverage:vitest": "turbo test --filter=!@covel/desktop --concurrency=2 --cache=local:,remote: -- --coverage",
    "test:coverage:desktop": "pnpm --filter @covel/desktop test:coverage",
    "test:coverage:runtime": "pnpm --filter @covel/runtime test --coverage",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --config tests/e2e/ci-smoke.config.ts",
    "e2e:extensions": "playwright test --config tests/e2e/third-party-stage.config.ts",
    "e2e:ui": "playwright test --ui",
    "dev:electron": "pnpm --filter @covel/desktop dev",
    "build:electron": "pnpm --filter @covel/desktop dist && node apps/desktop/scripts/cleanup-artifacts.mjs --strip-unpacked",
    "e2e:verify": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.llm scripts/e2e-plugin-verify.ts",
    "e2e:replay": "node scripts/llm-replay/run.mjs",
    "llm:replay": "node scripts/llm-replay/proxy.mjs",
    "llm:replay:diff": "node scripts/llm-replay/diff-runs.mjs",
    "test:runtime": "tsx packages/test-runtime/src/cli.ts",
    "schemas:generate": "pnpm --filter @covel/shared generate:schemas && prettier --write --log-level warn packages/shared/schemas && node scripts/generate-schema-reference.mjs",
    "describe:authoring": "node --import tsx scripts/describe-authoring.ts",
    "i18n": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.llm scripts/i18n.ts",
    "validate:plugin": "tsx packages/plugin-loader/scripts/validate-manifest.ts",
    "validate:world": "node --import tsx scripts/validate-release-worlds.ts",
    "validate:collection": "node --import tsx scripts/validate-collection.ts",
    "pack:collection": "pnpm --filter @covel/server exec tsx scripts/pack-collection.ts",
    "check:env": "node ./scripts/check-production-env.mjs",
    "create-plugin": "node scripts/create-plugin.js",
    "create-collection": "node scripts/create-collection.js",
    "release:preflight": "node ./scripts/release-preflight.mjs",
    "preinstall": "node ./scripts/require-pnpm.mjs",
    "check:boundaries": "node --test scripts/tests/package-imports.test.mjs && node scripts/check-package-boundaries.mjs"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26 <27"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.43.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-spawn": "^7.0.6",
    "fallow": "3.28.0",
    "oxlint": "1.86.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.8",
    "sqlite-vec": "^0.1.9",
    "tsx": "4.23.15",
    "turbo": "2.11.2",
    "yaml": "^2.9.1",
    "@covel/ai-provider": "workspace:*",
    "@covel/shared": "workspace:*",
    "oxc-parser": "0.151.0"
  }
}
