{
  "name": "covel",
  "version": "0.0.1-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-supervisor.mjs turbo dev",
    "dev:web": "node ./scripts/dev-supervisor.mjs turbo dev --filter=@covel/web",
    "dev:server": "node ./scripts/dev-supervisor.mjs turbo dev --filter=@covel/server",
    "dev:pg:preflight": "node ./scripts/dev-pg-preflight.mjs",
    "dev:pg": "pnpm run dev:pg:preflight && node ./scripts/dev-supervisor.mjs turbo dev:pg --filter=@covel/server",
    "stop": "node ./scripts/stop-dev.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:ci": "node ./scripts/lint-ci.mjs",
    "clean": "turbo clean",
    "db:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d postgres",
    "db:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "docker:build": "docker compose -f docker/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:down-all": "docker compose -f docker/docker-compose.yml --env-file .env down -v",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file .env logs -f",
    "db:migrate": "turbo db:migrate --filter=@covel/server",
    "db:generate": "turbo db:generate --filter=@covel/server",
    "db:studio": "turbo db:studio --filter=@covel/server",
    "check:i18n": "pnpm --filter @covel/web check:i18n && node ./scripts/check-plugin-i18n.mjs",
    "check:i18n:plugins": "node ./scripts/check-plugin-i18n.mjs",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:docker:up": "node ./scripts/e2e-docker.mjs up",
    "e2e:docker": "node ./scripts/e2e-docker.mjs run",
    "e2e:docker:down": "node ./scripts/e2e-docker.mjs down",
    "dev:electron": "pnpm --filter @covel/desktop dev",
    "dev:tauri": "pnpm --filter @covel/desktop-tauri dev",
    "build:electron": "pnpm --filter @covel/desktop dist",
    "build:tauri": "pnpm --filter @covel/desktop-tauri build:mac:arm64",
    "build:desktop": "pnpm run build:electron && pnpm run build:tauri",
    "e2e:verify": "tsx --env-file=.env --env-file=.env.llm scripts/e2e-plugin-verify.ts",
    "create-plugin": "node scripts/create-plugin.js"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "better-sqlite3": "^12.9.0",
    "playwright": "^1.59.1",
    "sqlite-vec": "^0.1.9",
    "turbo": "^2.9.6",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
