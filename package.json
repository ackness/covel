{
  "name": "covel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-supervisor.mjs turbo dev",
    "dev:web": "node ./scripts/dev-supervisor.mjs turbo dev --filter=@covel/web",
    "dev:server": "node ./scripts/dev-supervisor.mjs turbo dev --filter=@covel/server",
    "dev:pg": "node ./scripts/dev-supervisor.mjs turbo dev:pg --filter=@covel/server",
    "stop": "node ./scripts/stop-dev.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "db:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d postgres",
    "db:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "docker:build": "docker compose -f docker/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:down-all": "docker compose -f docker/docker-compose.yml --env-file .env down -v",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file .env logs -f",
    "db:migrate": "turbo db:migrate --filter=@covel/server",
    "db:generate": "turbo db:generate --filter=@covel/server",
    "db:studio": "turbo db:studio --filter=@covel/server",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:docker:up": "docker compose -f docker/docker-compose.e2e.yml up --build -d && echo 'Waiting for app...' && until curl -sf http://localhost:3001/api/health > /dev/null 2>&1; do sleep 2; done && echo 'App ready!'",
    "e2e:docker": "pnpm e2e:docker:up && E2E_BASE_URL=http://localhost:3001 pnpm e2e; EXIT=$?; docker compose -f docker/docker-compose.e2e.yml down -v; exit $EXIT",
    "e2e:docker:down": "docker compose -f docker/docker-compose.e2e.yml down -v",
    "desktop:dev": "pnpm --filter @covel/desktop dev",
    "desktop:build": "pnpm --filter @covel/desktop build",
    "desktop:dist": "pnpm --filter @covel/desktop dist",
    "e2e:verify": "tsx --env-file=.env --env-file=.env.llm scripts/e2e-plugin-verify.ts",
    "create-plugin": "node scripts/create-plugin.js"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@ai-sdk/provider-utils": "^3.0.12",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^4.1.2",
    "ai": "^5.0.0",
    "better-sqlite3": "^11.9.1",
    "playwright": "^1.59.1",
    "sqlite-vec": "0.1.7-alpha.2",
    "turbo": "^2.9.4",
    "yaml": "^2.8.3",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
